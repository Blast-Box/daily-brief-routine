   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-10-18-001",
     "event_id": "EVT-2026-10-18-001",
     "headline": "財務大臣が会見で、韓国との通貨スワップの延長が決まったと説明：インドとは財務相どうしの協議を格上げする方向",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "財務大臣は10月16日の閣議後の記者会見で、バンコクでの各国の財務相との会談について、韓国とは通貨スワップの延長が決まり、インドとは財務相どうしの二国間協議に格上げする方向でほぼ合意し、タイの財務大臣が11月に投資委員会を率いて来る予定だと説明した。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 11,
         "unit": "月",
         "label": "日付（タイの財務大臣が来る月）"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "韓国とは通貨スワップの延長が決まりましたし、インドとは蔵相間の二国間協議に格上げする方向がほぼ合意されましたし、インドネシアもそれを望んでおられます。またタイは11月に投資委員会を率いて財務大臣が来られる",
       "attribution": "出典：財務省「片山財務大臣兼内閣府特命担当大臣閣議後記者会見の概要(令和8年10月16日(金曜日))」（https://www.mof.go.jp/public_relations/conference/my20261016.html）",
       "processing_note": "財務省「片山財務大臣兼内閣府特命担当大臣閣議後記者会見の概要(令和8年10月16日(金曜日))」（https://www.mof.go.jp/public_relations/conference/my20261016.html）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "通貨スワップは、国どうしが、いざというときに互いの通貨やドルを融通し合う約束である。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-10-18-001-1",
       "text": "韓国との通貨の融通の約束が続くことで、急に外貨が足りなくなる心配が小さくなり、韓国と取引の多い国内の銀行業や輸出の多い製造業にとって、為替が大きく動いたときの資金繰りの不安が和らぐ可能性がある。",
       "falsifier": "延長の後も、韓国ウォンが円やドルに対して短い期間で大きく下がり続け、両国の当局が追加の対応を表明すれば、この見方は当たらない。",
       "check_metric": "財務省・日本銀行の発表と、円と韓国ウォンの為替相場",
       "check_by": "2026-12-31"
      }
     ],
     "followup": {
      "is_followup": false,
      "first_seen": null,
      "first_seen_edition_id": null,
      "has_new_source": null
     }
    }
   ]
