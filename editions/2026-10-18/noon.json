   "articles": [
    {
     "article_id": "ART-2026-10-18-001",
     "event_id": "EVT-2026-10-18-001",
     "headline": "続報：カカクコムの大株主デジタルガレージが変更報告書、KDDIと合わせた保有割合は38.31%（法定書類から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "カカクコムの大株主のデジタルガレージが、カカクコムの株の持ち方について、10月16日に変更報告書を出した。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 16,
         "unit": "日",
         "label": "日付（提出日）"
        }
       ],
       "source_ref": "SRC-007",
       "excerpt": "【提出日】2026年10月16日",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8DB）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8DB）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "書類では、報告が必要になった日は10月14日とされている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 14,
         "unit": "日",
         "label": "日付（報告義務発生日）"
        }
       ],
       "source_ref": "SRC-007",
       "excerpt": "【報告義務発生日】2026年10月14日",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8DB）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8DB）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "デジタルガレージが持つカカクコムの株の割合は20.64%である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 20.64,
         "unit": "%",
         "label": "デジタルガレージの株券等保有割合"
        }
       ],
       "source_ref": "SRC-007",
       "excerpt": "上記提出者の株券等保有割合（％）（AB/（AD+AE-AF）×100）20.64",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8DB）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8DB）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "一緒に届け出たKDDIの割合は17.67%である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 17.67,
         "unit": "%",
         "label": "KDDIの株券等保有割合"
        }
       ],
       "source_ref": "SRC-007",
       "excerpt": "上記共同保有者の株券等保有割合（％）（AB/（AD+AE-AF）×100）17.67",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8DB）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8DB）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "2社を合わせた割合は38.31%になる。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 38.31,
         "unit": "%",
         "label": "2社を合わせた株券等保有割合"
        }
       ],
       "source_ref": "SRC-007",
       "excerpt": "上記提出者の株券等保有割合（％）（AB/（AD+AE-AF）×100）38.31",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8DB）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8DB）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "デジタルガレージは5月12日に、買付けをする会社との間で、公開買付けに応じないことなどを定めた契約を結んでいる。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 12,
         "unit": "日",
         "label": "日付（契約の締結）"
        }
       ],
       "source_ref": "SRC-007",
       "excerpt": "提出者は、2026年5月12日付で、Kamgras 1株式会社（以下「公開買付者」といいます。）との間で、公開買付けへの不応募等に関する契約",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8DB）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8DB）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "書類に書かれた一連の取引には、非公開化の後に、買付けをする会社の親会社などに出資し直して、議決権の約20%を持つ株を取得することが含まれている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 20,
         "unit": "%",
         "label": "再出資対象会社の議決権所有割合（約）"
        }
       ],
       "source_ref": "SRC-007",
       "excerpt": "再出資対象会社の普通株式（議決権所有割合約20％）を取得すること",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8DB）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8DB）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-08",
       "text": "公開買付けは、決めた値段と期間で、株主から株を買い集める手続きである。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-09",
       "text": "変更報告書は、上場会社の株をたくさん持つ株主が、持ち方や持つ目的が変わったときに出す書類である。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-10-18-001-1",
       "text": "大株主が公開買付けに応じない契約を結んでいる場合、買付けで集まる株の数は、残りの株主の応じ方で決まる可能性がある。",
       "falsifier": "公開買付けの結果で、応募した株の数が買い集める株の数の下限を大きく上回れば、残りの株主の応じ方が決め手だったとは言いにくくなる。",
       "check_metric": "EDINETに出される公開買付報告書の応募株券等の数",
       "check_by": "2026-11-06"
      }
     ],
     "followup": {
      "is_followup": false,
      "first_seen": null,
      "first_seen_edition_id": null,
      "has_new_source": null
     }
