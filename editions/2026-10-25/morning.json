 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-10-25-001",
     "event_id": "EVT-2026-10-25-001",
     "headline": "社債を出すための枠を登録：光通信は200,000百万円、アイザワ証券グループ・ニシオHD・矢作建設工業も（法定書類から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "発行登録は、会社が先に「これから2年の間に、この金額まで社債などを出す」と国に届け出ておき、実際に出すときの手続きを短くできる仕組みである。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "情報通信の販売などを行う光通信は、10月23日に発行登録書を提出し、社債の発行予定額を200,000百万円とした。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 200000,
         "unit": "百万円",
         "label": "社債の発行予定額（光通信）"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "発行予定額 200,000百万円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7O8）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7O8）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "光通信の発行登録は、効力が生じる予定の日を2026年10月31日とし、そこから2年の間を発行の予定期間としている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 31,
         "unit": "日",
         "label": "日付（効力発生予定日）"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "この発行登録書による発行登録の効力発生予定日(2026年10月31日)から",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7O8）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7O8）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "証券会社を持つアイザワ証券グループは、社債の発行予定額を30,000百万円とする発行登録書を同じ日に提出した。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 30000,
         "unit": "百万円",
         "label": "社債の発行予定額（アイザワ証券グループ）"
        }
       ],
       "source_ref": "SRC-004",
       "excerpt": "発行予定額 30,000百万円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9GB）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9GB）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "建設機械のレンタルなどを行うニシオホールディングスは、社債の発行予定額を20,000百万円とした。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 20000,
         "unit": "百万円",
         "label": "社債の発行予定額（ニシオホールディングス）"
        }
       ],
       "source_ref": "SRC-002",
       "excerpt": "発行予定額 20,000百万円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9K4）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9K4）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "建設業の矢作建設工業は、社債の発行予定額を10,000百万円とした。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 10000,
         "unit": "百万円",
         "label": "社債の発行予定額（矢作建設工業）"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "発行予定額 10,000百万円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z903）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z903）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "発行登録をしても、実際に社債を出すかどうか、いつ・いくら出すかは、その時に改めて決めて「追補書類」で届け出る。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-10-25-001-1",
       "text": "金利が上がる中でも、建設や機械レンタルの会社が社債で資金を集める準備を続けていることは、設備や工事のためのお金の需要が続いていることを示している可能性がある。",
       "falsifier": "今後数か月の間に、これらの業種の会社が登録した枠を使わず、社債の発行が目立って減れば、この見方は弱まる。",
       "check_metric": "EDINETの発行登録追補書類（建設業・機械レンタルの会社）の提出件数と金額",
       "check_by": "2027-01-31"
      }
     ],
