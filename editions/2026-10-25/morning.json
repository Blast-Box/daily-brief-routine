   "articles": [
    {
     "article_id": "ART-2026-10-25-002",
     "event_id": "EVT-2026-10-25-002",
     "headline": "中古マンションの買い取り販売のランドネット、7月期の売上高は109,953百万円で14.5%増、借入れの利息は419百万円に（法定書類から）",
     "lines": [
      {
       "line_id": "L-002-01",
       "text": "ランドネットは、中古マンションなどを持ち主から買い取り、手を入れて売る事業や、仲介、賃貸の管理を行う会社である（10月23日に提出した有価証券報告書から）。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 4,
         "unit": "社",
         "label": "会社の数（グループ）"
        }
       ],
       "source_ref": "SRC-005",
       "excerpt": "当社グループは、当社及び連結子会社（株式会社ランドインシュア、日昇房屋有限公司、日商朗透房屋股份有限公司）の計４社で構成されており",
