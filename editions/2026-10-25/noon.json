 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-10-25-001",
     "event_id": "EVT-2026-10-25-001",
     "headline": "化粧品の2社が年に1度の報告書で中国の環境悪化を説明：アクシージアは営業損失、プレミアアンチエイジングは中国の現地法人を解散へ（法定書類から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "アクシージアは、化粧品と健康補助食品を作って売る会社で、グループは同社と子会社9社でできている（10月23日に提出した有価証券報告書から）。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 9,
         "unit": "社",
         "label": "会社の数（子会社）"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "当社グループは、当社と子会社９社で構成され、化粧品及び健康補助食品の製造・販売を主な事業としております",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9OJ）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9OJ）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "同社グループの中国向けの売上高は、2026年7月までの1年間で売上高全体の71.4%を占めた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 71.4,
         "unit": "%",
         "label": "中国向けの売上高の割合"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "当社グループにおける中国向けの売上高は当連結会計年度において71.4％に達しております",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9OJ）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9OJ）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "書類は、日中関係の緊張などで中国の事業環境が悪くなる影響を受けたとしたうえで、売上高は13,466,653千円で、前の年より0.1%減ったと書いている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 13466653,
         "unit": "千円",
         "label": "売上高（連結）"
        },
        {
         "value": 0.1,
         "unit": "%",
         "label": "売上高の前年比の減少率"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "日中関係緊張等による中国事業環境悪化の影響を受けたものの、売上高は13,466,653千円（前期比0.1％減）",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9OJ）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9OJ）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "中国のネット通販での広告宣伝費の高騰や、人を増やしたことによる人件費の増加などで、本業のもうけを示す営業損益は176,456千円の損失になった（前の年は513,372千円の利益）。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 176456,
         "unit": "千円",
         "label": "営業損失"
        },
        {
         "value": 513372,
         "unit": "千円",
         "label": "前の年の営業利益"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "中国ECにおける広告宣伝費の高騰や、事業投資のための人員拡大に伴う人件費増加等の影響で、営業損失は176,456千円（前年同期は営業利益513,372千円）",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9OJ）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9OJ）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "経常利益は23,578千円で、前の年より95.3%減った。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 23578,
         "unit": "千円",
         "label": "経常利益"
        },
        {
         "value": 95.3,
         "unit": "%",
         "label": "経常利益の前年比の減少率"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "経常利益は23,578千円（同95.3％減）",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9OJ）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9OJ）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "プレミアアンチエイジングは、化粧品などのアンチエイジング事業と、子会社によるリカバリー事業を行っており、グループは同社と連結子会社2社、非連結子会社1社でできている（10月23日に提出した有価証券報告書から）。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2,
         "unit": "社",
         "label": "会社の数（連結子会社）"
        },
        {
         "value": 1,
         "unit": "社",
         "label": "会社の数（非連結子会社）"
        }
       ],
       "source_ref": "SRC-002",
       "excerpt": "当社グループは、当社と連結子会社２社、非連結子会社１社で構成されており、アンチエイジング事業及びリカバリー事業を展開しております",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9QW）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9QW）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "2026年7月までの1年間の売上高は、全体で13,883百万円となり、前の年より14.1%減った。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 13883,
         "unit": "百万円",
         "label": "売上高（連結）"
        },
        {
         "value": 14.1,
         "unit": "%",
         "label": "売上高の前年比の減少率"
        }
       ],
       "source_ref": "SRC-002",
       "excerpt": "全体では13,883百万円（前期比14.1%減）",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9QW）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9QW）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
