 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-10-19-001",
     "event_id": "EVT-2026-10-19-001",
     "headline": "物価高のなかのカジュアル衣料：ジーイエットの3〜8月は売上高8,552百万円・営業損失757百万円、25店舗を閉じる（法定書類から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "ジーイエットの2026年3月から8月までの半年間の連結の売上高は8,552百万円、営業損失は757百万円だった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 8552,
         "unit": "百万円",
         "label": "中間期の売上高"
        },
        {
         "value": 757,
         "unit": "百万円",
         "label": "中間期の営業損失"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "売上高8,552百万円、営業損失757百万円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7OV）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7OV）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "経常損失は709百万円、親会社の株主に帰属する中間純損失は182百万円だった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 709,
         "unit": "百万円",
         "label": "中間期の経常損失"
        },
        {
         "value": 182,
         "unit": "百万円",
         "label": "中間期の親会社株主に帰属する中間純損失"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "経常損失709百万円、親会社株主に帰属する中間純損失182百万円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7OV）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7OV）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "半期報告書は、上場会社などが、事業年度の前半6か月の業績や財産の状況を国に届け出る書類である。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "同社は、ジーイエットの店について、25店舗を閉じた結果、店舗数は155店舗になったと書いている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 25,
         "unit": "店舗",
         "label": "件数（ジーイエットの退店）"
        },
        {
         "value": 155,
         "unit": "店舗",
         "label": "ジーイエットの店舗数"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "ジーイエット株式会社は25店舗の退店により店舗数は155店舗となりました",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7OV）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7OV）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "子会社の店も合わせたグループ全体では、半年の間に閉じた店は25店舗、店舗数は229店舗になった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 25,
         "unit": "店舗",
         "label": "件数（グループ全体の退店）"
        },
        {
         "value": 229,
         "unit": "店舗",
         "label": "グループ全体の店舗数"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "グループ全体での当中間連結累計期間中の退店数は25店舗、店舗数は229店舗となりました",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7OV）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7OV）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "同社は、前の事業年度まで8期続けて営業損失を計上しており、「継続企業の前提に関する重要な疑義を生じさせる事象又は状況」があると書いている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 8,
         "unit": "期",
         "label": "件数（営業損失が続いた事業年度）"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "前事業年度まで８期連続して営業損失を計上しており、継続企業の前提に関する重要な疑義を生じさせる事象又は状況が存在しております",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7OV）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7OV）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "「継続企業の前提」とは、会社がこの先も事業を続けていくという、決算書をつくるときの前提のことである。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-08",
       "text": "同社は、主力事業の売上高が当初の計画を下回ったことや、暗号資産の取引にかかる収益を売上高と売上総利益から外したことなどを踏まえ、2026年8月20日に中間期と通期の業績予想を修正していた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 20,
         "unit": "日",
         "label": "日付（業績予想の修正日）"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "暗号資産取引に係る収益の計上方法を売上高及び売上総利益から除外したことなどを踏まえ、2026年８月20日に第２四半期（中間期）及び通期の連結業績予想を修正いたしました",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7OV）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7OV）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-09",
       "text": "3月から8月の営業活動では、差し引きで1,825百万円のお金が出ていった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 1825,
         "unit": "百万円",
         "label": "中間期の営業活動によるキャッシュ・フロー（支出）"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "営業活動の結果支出した資金は、1,825百万円となりました。",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7OV）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7OV）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-10",
       "text": "8月末の手元の現金と、すぐ現金にできる預金などの合計は1,364百万円だった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 1364,
         "unit": "百万円",
         "label": "中間期末の現金及び現金同等物"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "当中間連結会計期間末における現金及び現金同等物（以下「資金」という。）は、1,364百万円となりました。",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7OV）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
