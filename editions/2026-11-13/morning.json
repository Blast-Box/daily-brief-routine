   "articles": [
    {
     "article_id": "ART-2026-11-13-001",
     "event_id": "EVT-2026-11-13-001",
     "headline": "米連邦準備制度理事会の週次の資産・負債の統計：米国債の保有は4,583,294百万ドルで1年前より390,388百万ドル多く、住宅ローン担保証券は減る",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "米連邦準備制度理事会（FRB）が11月12日付で公表した週次の統計（H.4.1）によると、11月11日までの1週間の平均で、連邦準備銀行の「準備銀行信用」（資産の大部分）は6,707,462百万ドルだった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 6707462,
         "unit": "百万ドル",
         "label": "準備銀行信用（11月11日までの週の平均）"
        }
       ],
       "source_ref": "SRC-009",
       "excerpt": "Reserve Bank credit 6,707,462",
       "attribution": "出典：Board of Governors of the Federal Reserve System「Factors Affecting Reserve Balances of Depository Institutions and Condition Statement of Federal Reserve Banks」（https://www.federalreserve.gov/releases/h41/current/h41.pdf）",
       "processing_note": "Board of Governors of the Federal Reserve System「Factors Affecting Reserve Balances of Depository Institutions and Condition Statement of Federal Reserve Banks」（https://www.federalreserve.gov/releases/h41/current/h41.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "このうち保有する米国債は4,583,294百万ドルで、1年前の同じ週より390,388百万ドル多い。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 4583294,
         "unit": "百万ドル",
         "label": "保有する米国債（週の平均）"
        },
        {
         "value": 390388,
         "unit": "百万ドル",
         "label": "米国債の保有の1年前の週からの増加"
        }
       ],
       "source_ref": "SRC-009",
       "excerpt": "U.S. Treasury securities 4,583,294 + 4,950 + 390,388",
       "attribution": "出典：Board of Governors of the Federal Reserve System「Factors Affecting Reserve Balances of Depository Institutions and Condition Statement of Federal Reserve Banks」（https://www.federalreserve.gov/releases/h41/current/h41.pdf）",
       "processing_note": "Board of Governors of the Federal Reserve System「Factors Affecting Reserve Balances of Depository Institutions and Condition Statement of Federal Reserve Banks」（https://www.federalreserve.gov/releases/h41/current/h41.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "米国債のうち短期国債は577,529百万ドルで、1年前の同じ週より382,036百万ドル多い。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 577529,
         "unit": "百万ドル",
         "label": "保有する短期国債（週の平均）"
        },
        {
         "value": 382036,
         "unit": "百万ドル",
         "label": "短期国債の保有の1年前の週からの増加"
        }
       ],
       "source_ref": "SRC-009",
       "excerpt": "Bills2 577,529 + 4,435 + 382,036",
       "attribution": "出典：Board of Governors of the Federal Reserve System「Factors Affecting Reserve Balances of Depository Institutions and Condition Statement of Federal Reserve Banks」（https://www.federalreserve.gov/releases/h41/current/h41.pdf）",
       "processing_note": "Board of Governors of the Federal Reserve System「Factors Affecting Reserve Balances of Depository Institutions and Condition Statement of Federal Reserve Banks」（https://www.federalreserve.gov/releases/h41/current/h41.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "住宅ローン担保証券の保有は1,883,522百万ドルで、1年前の同じ週より186,441百万ドル少ない。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 1883522,
         "unit": "百万ドル",
         "label": "保有する住宅ローン担保証券（週の平均）"
        },
        {
         "value": 186441,
         "unit": "百万ドル",
         "label": "住宅ローン担保証券の保有の1年前の週からの減少幅"
        }
       ],
       "source_ref": "SRC-009",
       "excerpt": "Mortgage-backed securities4 1,883,522 0 - 186,441",
       "attribution": "出典：Board of Governors of the Federal Reserve System「Factors Affecting Reserve Balances of Depository Institutions and Condition Statement of Federal Reserve Banks」（https://www.federalreserve.gov/releases/h41/current/h41.pdf）",
       "processing_note": "Board of Governors of the Federal Reserve System「Factors Affecting Reserve Balances of Depository Institutions and Condition Statement of Federal Reserve Banks」（https://www.federalreserve.gov/releases/h41/current/h41.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "銀行などが連邦準備銀行に預けている準備預金の残高は2,960,603百万ドルで、前の週より30,515百万ドル増えた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2960603,
         "unit": "百万ドル",
         "label": "準備預金の残高（週の平均）"
        },
        {
         "value": 30515,
         "unit": "百万ドル",
         "label": "準備預金の前の週からの増加"
        }
       ],
       "source_ref": "SRC-009",
       "excerpt": "Reserve balances with Federal Reserve Banks 2,960,603 + 30,515",
       "attribution": "出典：Board of Governors of the Federal Reserve System「Factors Affecting Reserve Balances of Depository Institutions and Condition Statement of Federal Reserve Banks」（https://www.federalreserve.gov/releases/h41/current/h41.pdf）",
       "processing_note": "Board of Governors of the Federal Reserve System「Factors Affecting Reserve Balances of Depository Institutions and Condition Statement of Federal Reserve Banks」（https://www.federalreserve.gov/releases/h41/current/h41.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "米財務省が連邦準備銀行に置く一般勘定の残高は914,370百万ドルで、前の週より42,805百万ドル減った。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 914370,
         "unit": "百万ドル",
         "label": "米財務省の一般勘定の残高（週の平均）"
        },
        {
         "value": 42805,
         "unit": "百万ドル",
         "label": "一般勘定の前の週からの減少幅"
        }
       ],
       "source_ref": "SRC-009",
       "excerpt": "U.S. Treasury, General Account 914,370 - 42,805",
       "attribution": "出典：Board of Governors of the Federal Reserve System「Factors Affecting Reserve Balances of Depository Institutions and Condition Statement of Federal Reserve Banks」（https://www.federalreserve.gov/releases/h41/current/h41.pdf）",
       "processing_note": "Board of Governors of the Federal Reserve System「Factors Affecting Reserve Balances of Depository Institutions and Condition Statement of Federal Reserve Banks」（https://www.federalreserve.gov/releases/h41/current/h41.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "準備預金は、銀行が中央銀行に置いている預金で、銀行どうしのお金の貸し借りの土台になる。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-08",
       "text": "政府が中央銀行の口座にお金をためると、その分だけ銀行の準備預金が減り、口座のお金を使うと準備預金が増える関係にある。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-11-13-001-1",
       "text": "米国の準備預金の残高が高い水準で保たれれば、ドルの短期の資金を市場で借りる銀行業の資金繰りは落ち着いたままになる可能性がある。",
       "falsifier": "今後数週間の統計で準備預金の残高が大きく減り続ければ、この見方は成り立たない。",
       "check_metric": "FRB H.4.1 の Reserve balances with Federal Reserve Banks（週の平均）",
       "check_by": "2026-12-31"
      }
     ],
     "followup": {
      "is_followup": false,
