 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-11-13-001",
     "event_id": "EVT-2026-11-13-001",
     "headline": "日本銀行の審議委員が長崎で挨拶：6月と9月の利上げに反対した理由を説明、ETFの売却は年8,600億円のペースに",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "日本銀行の審議委員は2026年11月12日の長崎県での挨拶で、日本銀行が6月と9月の会合で利上げを決め、政策金利がおよそ30年ぶりに1.25%になったと説明した。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 1.25,
         "unit": "%",
         "label": "政策金利"
        },
        {
         "value": 30,
         "unit": "年",
         "label": "何年ぶりの水準か"
        }
       ],
       "source_ref": "SRC-010",
       "excerpt": "利はおよそ 30 年ぶりに 1.25％となりました（図表９左）。",
       "attribution": "出典：日本銀行「わが国の経済・物価情勢と金融政策 ── 長崎県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261112a1.pdf）",
       "processing_note": "日本銀行「わが国の経済・物価情勢と金融政策 ── 長崎県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261112a1.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "政策金利は、日本銀行が金融政策の目安にする短い期間の金利で、上がると銀行の貸出金利なども上がりやすい。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "この審議委員は6月と9月の会合で利上げに反対票を投じており、その理由として、足もとのインフレ率が2%を下回るなか、経済の状況も必ずしも強いとはいえない点を挙げた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2,
         "unit": "%",
         "label": "足もとのインフレ率と比べた水準"
        }
       ],
       "source_ref": "SRC-010",
       "excerpt": "とのインフレ率が２％を下回るなか、経済の状況も必ずしも強いとはいえない",
       "attribution": "出典：日本銀行「わが国の経済・物価情勢と金融政策 ── 長崎県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261112a1.pdf）",
       "processing_note": "日本銀行「わが国の経済・物価情勢と金融政策 ── 長崎県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261112a1.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "物価については、企業どうしの取引価格である国内企業物価の前年比が7%程度の高い伸びになっていると述べた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 7,
         "unit": "%",
         "label": "国内企業物価の前年比"
        }
       ],
       "source_ref": "SRC-010",
       "excerpt": "格である国内企業物価の前年比をみると、７％程度の高い伸びとなっています",
       "attribution": "出典：日本銀行「わが国の経済・物価情勢と金融政策 ── 長崎県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261112a1.pdf）",
       "processing_note": "日本銀行「わが国の経済・物価情勢と金融政策 ── 長崎県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261112a1.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "賃金については、毎月決まって支払われる所定内給与の前年比が3%程度の伸びになっていると述べた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 3,
         "unit": "%",
         "label": "所定内給与の前年比"
        }
       ],
       "source_ref": "SRC-010",
       "excerpt": "したことで、所定内給与の前年比は３％程度の伸びとなっているほか、特別給与",
       "attribution": "出典：日本銀行「わが国の経済・物価情勢と金融政策 ── 長崎県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261112a1.pdf）",
       "processing_note": "日本銀行「わが国の経済・物価情勢と金融政策 ── 長崎県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261112a1.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "ETF（上場投資信託）は、多くの会社の株をまとめて組み入れ、株と同じように取引所で売り買いされる投資信託である。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "日本銀行が持つETFの売却について、10月の会合で決めた見直しにより、年間の売却ペースは3,300億円から8,600億円に増えると説明した。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 3300,
         "unit": "億円",
         "label": "ETFの年間の売却ペース（従来）"
        },
        {
         "value": 8600,
         "unit": "億円",
         "label": "ETFの年間の売却ペース（見直し後）"
        }
       ],
       "source_ref": "SRC-010",
       "excerpt": "これにより、年間の売却ペースは従来の 3,300 億円から 8,600 億円に増加し、",
       "attribution": "出典：日本銀行「わが国の経済・物価情勢と金融政策 ── 長崎県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261112a1.pdf）",
       "processing_note": "日本銀行「わが国の経済・物価情勢と金融政策 ── 長崎県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261112a1.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-08",
       "text": "売却を終えるまでにかかる年数も、112年から43年程度に縮まる見込みだという。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 112,
         "unit": "年",
         "label": "売却完了までの年数（従来）"
        },
        {
         "value": 43,
         "unit": "年",
         "label": "売却完了までの年数（見直し後）"
        }
       ],
       "source_ref": "SRC-010",
       "excerpt": "売却完了までにかかる年数も、従来の 112 年から 43 年程度へと縮小する見込み",
       "attribution": "出典：日本銀行「わが国の経済・物価情勢と金融政策 ── 長崎県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261112a1.pdf）",
       "processing_note": "日本銀行「わが国の経済・物価情勢と金融政策 ── 長崎県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261112a1.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-09",
       "text": "日本銀行の政策委員会は、総裁・副総裁と審議委員の多数決で金融政策を決める。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-11-13-001-1",
       "text": "政策金利の引き上げが続けば、銀行業では貸出金利の上昇を通じて利ざやが広がる可能性がある一方、借入れの多い不動産業などでは利払いの負担が重くなる可能性がある。",
       "falsifier": "次回以降の金融政策決定会合で政策金利が据え置かれ続ければ、この見方の前提が崩れる。",
       "check_metric": "日本銀行 金融政策決定会合の公表文（政策金利）と、貸出約定平均金利",
       "check_by": "2027-01-31"
      },
      {
       "inference_id": "INF-2026-11-13-001-2",
       "text": "ETFの年間の売却額が増えることで、株式市場で売りに回る株の量が少しずつ増える可能性がある。",
       "falsifier": "日本銀行が市場の状況を理由に売却の一時的な調整や停止を発表すれば、この見方は当てはまらない。",
       "check_metric": "日本銀行 営業毎旬報告のETFの残高",
       "check_by": "2027-03-31"
      }
     ],
