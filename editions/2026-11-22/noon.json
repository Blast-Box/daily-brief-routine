 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-11-22-001",
     "event_id": "EVT-2026-11-22-001",
     "headline": "財政制度等審議会が来年度予算への建議：医療費の窓口負担は「3割負担の対象の拡大を含め」引き上げるべき、介護は2割負担の範囲を拡大（財務省）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "財政制度等審議会は、国の予算や財政のあり方について意見をまとめ、財務大臣に伝える審議会である。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "財政制度等審議会が11月にまとめた「令和9年度予算の編成等に関する建議」の概要は、令和9年度の社会保障負担率が令和7年度と比べて上昇しないよう取り組む必要があるとした。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 9,
         "unit": "年度",
         "label": "日付（対象の年度：令和9年度）"
        },
        {
         "value": 7,
         "unit": "年度",
         "label": "日付（比べる年度：令和7年度）"
        }
       ],
       "source_ref": "SRC-002",
       "excerpt": "令和９年度の社会保障負担率が令和７年度と比較して上昇しないよう取り組む必要",
       "attribution": "出典：財務省「令和９年度予算の編成等に関する建議 概要」（https://www.mof.go.jp/about_mof/councils/fiscal_system_council/sub-of_fiscal_system/report/zaiseia20261120/02.pdf）",
       "processing_note": "財務省「令和９年度予算の編成等に関する建議 概要」（https://www.mof.go.jp/about_mof/councils/fiscal_system_council/sub-of_fiscal_system/report/zaiseia20261120/02.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "医療については、低所得者などの必要な受診が確保されるよう配慮することを前提に、医療費の窓口負担を「3割負担の対象の拡大を含め」着実に引き上げるべきだとした。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 3,
         "unit": "割",
         "label": "医療費の窓口負担の割合（3割負担）"
        }
       ],
       "source_ref": "SRC-002",
       "excerpt": "医療費の窓口負担は、3割負担の対象の拡大を含め、着実に引き上げるべき。",
       "attribution": "出典：財務省「令和９年度予算の編成等に関する建議 概要」（https://www.mof.go.jp/about_mof/councils/fiscal_system_council/sub-of_fiscal_system/report/zaiseia20261120/02.pdf）",
       "processing_note": "財務省「令和９年度予算の編成等に関する建議 概要」（https://www.mof.go.jp/about_mof/councils/fiscal_system_council/sub-of_fiscal_system/report/zaiseia20261120/02.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "介護保険の利用者負担については、2割負担が適用される範囲を広げるほか、金融所得の勘案など、負担できる力をより適切に反映する必要があるとした。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2,
         "unit": "割",
         "label": "介護保険の利用者負担の割合（2割負担）"
        }
       ],
       "source_ref": "SRC-002",
       "excerpt": "介護保険の利用者負担について、２割負担の適用範囲を拡大するほか、金融所得の勘案等",
       "attribution": "出典：財務省「令和９年度予算の編成等に関する建議 概要」（https://www.mof.go.jp/about_mof/councils/fiscal_system_council/sub-of_fiscal_system/report/zaiseia20261120/02.pdf）",
       "processing_note": "財務省「令和９年度予算の編成等に関する建議 概要」（https://www.mof.go.jp/about_mof/councils/fiscal_system_council/sub-of_fiscal_system/report/zaiseia20261120/02.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "令和9年度の介護報酬の改定は、賃金・物価の動きに対応して介護の人材を確保しつつ、現役世代の負担を抑える観点から、報酬の適正化に取り組むべきだとした。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 9,
         "unit": "年度",
         "label": "日付（対象の年度：令和9年度）"
        }
       ],
       "source_ref": "SRC-002",
       "excerpt": "令和９年度介護報酬改定は、賃金・物価動向の変化に的確に対応し、介護人材を確保するとともに",
       "attribution": "出典：財務省「令和９年度予算の編成等に関する建議 概要」（https://www.mof.go.jp/about_mof/councils/fiscal_system_council/sub-of_fiscal_system/report/zaiseia20261120/02.pdf）",
       "processing_note": "財務省「令和９年度予算の編成等に関する建議 概要」（https://www.mof.go.jp/about_mof/councils/fiscal_system_council/sub-of_fiscal_system/report/zaiseia20261120/02.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "国の情報システムについては、運用経費などを3割削減する目標は達成が難しい見通しだとして、費用対効果が乏しいものは廃止・統合を含めた対応が必要だとした。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 3,
         "unit": "割",
         "label": "情報システムの運用経費等の削減目標（3割）"
        }
       ],
       "source_ref": "SRC-002",
       "excerpt": "既存の情報システムの運用経費等の３割削減目標は達成困難な見通し。",
       "attribution": "出典：財務省「令和９年度予算の編成等に関する建議 概要」（https://www.mof.go.jp/about_mof/councils/fiscal_system_council/sub-of_fiscal_system/report/zaiseia20261120/02.pdf）",
       "processing_note": "財務省「令和９年度予算の編成等に関する建議 概要」（https://www.mof.go.jp/about_mof/councils/fiscal_system_council/sub-of_fiscal_system/report/zaiseia20261120/02.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "建議は審議会の意見であり、予算そのものは政府が案をつくり、国会の議決で決まる。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-11-22-001-1",
       "text": "医療費や介護の自己負担の引き上げが実際に決まれば、医療業や介護サービスの利用の伸びが鈍る可能性がある。",
       "falsifier": "12月に決まる令和9年度予算の政府案や制度改正で、窓口負担・利用者負担の引き上げが見送られれば、この見方は成り立たない。",
       "check_metric": "令和9年度予算政府案の社会保障関係費と、医療費の窓口負担・介護の2割負担の範囲に関する制度改正の内容",
       "check_by": "2026-12-31"
      },
      {
       "inference_id": "INF-2026-11-22-001-2",
       "text": "国の情報システムの廃止・統合が進めば、官公庁向けのシステム開発を手がける情報・通信業の受注に影響する可能性がある。",
       "falsifier": "令和9年度予算の政府案で、情報システム関係の予算額が前年度より増えていれば、この見方は当てはまりにくい。",
       "check_metric": "令和9年度予算政府案のデジタル庁一括計上の情報システム関係予算",
       "check_by": "2026-12-31"
      }
     ],
