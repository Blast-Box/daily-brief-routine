   "articles": [
    {
     "article_id": "ART-2026-11-22-002",
     "event_id": "EVT-2026-11-22-002",
     "headline": "続報：JTの配当と国の出資の財源──財務大臣、政府はJTの株の約3分の1を持ち、配当は財政投融資の産業投資の財源と説明",
     "lines": [
      {
       "line_id": "L-002-01",
       "text": "財務大臣は11月20日の閣議後の記者会見で、政府がJTの発行済み株式の約3分の1を保有し、その配当金は財政投融資のうち産業投資の財源として活用されていると説明した。配当予想の修正を受けても、投資勘定全体で見れば産業投資に直ちに支障を生じることはないとの考えも示した。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 3,
         "unit": "分の1",
         "label": "政府が持つJT株の割合（約3分の1の「3」）"
        },
        {
         "value": 1,
         "unit": "",
         "label": "政府が持つJT株の割合（約3分の1の「1」）"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "政府はＪＴの発行済み株式の約３分の１を保有しておりまして、この配当金は財政投融資のうちの産業投資の財源として活用されています",
       "attribution": "出典：財務省「片山財務大臣兼内閣府特命担当大臣閣議後記者会見の概要(令和8年11月20日(金曜日))」（https://www.mof.go.jp/public_relations/conference/my20261120.html）",
       "processing_note": "財務省「片山財務大臣兼内閣府特命担当大臣閣議後記者会見の概要(令和8年11月20日(金曜日))」（https://www.mof.go.jp/public_relations/conference/my20261120.html）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-02",
       "text": "財政投融資の産業投資は、国が持つ株の配当などを元手に、民間だけでは資金が集まりにくい事業へ出資する仕組みである。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-11-22-002-1",
       "text": "国が株を持つ会社の配当が減ると、財政投融資の産業投資に回せるお金の見通しが変わり、出資を受ける事業の分野に影響する可能性がある。",
       "falsifier": "令和9年度の財政投融資計画で、産業投資の計画額が令和8年度より増えていれば、この見方は当てはまりにくい。",
