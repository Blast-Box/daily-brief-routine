 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-10-14-001",
     "event_id": "EVT-2026-10-14-001",
     "headline": "衣料品のワールドとTSIホールディングスが、共同で持株会社をつくり経営を統合する計画を届け出る（法定書類から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "ワールドとTSIホールディングスは、共同株式移転の方法で両社の完全親会社となる会社を2027年3月1日（予定）に設けると、臨時報告書で届け出た。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2027,
         "unit": "年",
         "label": "日付（共同株式移転の予定年）"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "は、2027年３月１日（予定）をもって、共同株式移転（以下「本株式移転」といいます。）の方法により両社の完全親会社となる",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7EY）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7EY）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "共同株式移転は、複数の会社が一緒に新しい親会社をつくり、それぞれの株主が持つ株を新しい親会社の株と交換するしくみである。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "ワールドの株1株には新しい持株会社の株1株が、TSIホールディングスの株1株には新しい持株会社の株0.8株が割り当てられる予定である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 1,
         "unit": "株",
         "label": "ワールドの株1株に割り当てる新会社の株数"
        },
        {
         "value": 0.8,
         "unit": "株",
         "label": "TSIホールディングスの株1株に割り当てる新会社の株数"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "当社の普通株式１株に対して共同持株会社の普通株式１株を、TSIHDの普通株式１株に対して共同持株会社の普通株式0.8株を割り当て交付いたします",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7EY）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7EY）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "ワールドとTSIホールディングスの株は、それぞれ2027年2月25日に上場をやめる予定とされている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2027,
         "unit": "年",
         "label": "日付（上場廃止の予定年）"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "ワールド及びTSIHDはそれぞれ2027年２月25日に上場廃止予定",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7EY）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7EY）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "新しい持株会社（インフィニティ・ユナイテッド）は、2027年3月1日に東証プライム市場に上場する予定とされている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2027,
         "unit": "年",
         "label": "日付（新規上場の予定年）"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "共同持株会社（インフィニティ・ユナイテッド）は2027年３月１日に東証プライム市場に新規上場予定（テクニカル上場）",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7EY）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7EY）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "ワールドは、この計画を承認するための臨時株主総会を2026年12月24日に開く予定としている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2026,
         "unit": "年",
         "label": "日付（臨時株主総会の予定年）"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "株式移転計画承認臨時株主総会（当社）  2026年12月24日（木）（予定）",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7EY）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7EY）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "ワールドの連結の売上高（国際会計基準の売上収益）は、2026年2月期が284,014百万円、その前の期が225,658百万円だった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 284014,
         "unit": "百万円",
         "label": "ワールドの連結売上高（2026年2月期）"
        },
        {
         "value": 225658,
         "unit": "百万円",
         "label": "ワールドの連結売上高（2025年2月期）"
        }
       ],
       "source_ref": "SRC-007",
       "excerpt": "売上高（百万円）  202,342  225,658  284,014",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z81W）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z81W）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-08",
       "text": "TSIホールディングスの連結の売上高は、2026年2月期が167,085百万円、その前の期が156,606百万円だった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 167085,
         "unit": "百万円",
         "label": "TSIホールディングスの連結売上高（2026年2月期）"
        },
        {
         "value": 156606,
         "unit": "百万円",
         "label": "TSIホールディングスの連結売上高（2025年2月期）"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "売上高（百万円）  155,383  156,606  167,085",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7EY）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7EY）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-09",
