 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-10-14-001",
     "event_id": "EVT-2026-10-14-001",
     "headline": "ビットコインを持つ会社が、利息の付かない転換社債で約519億円を集めると決める（法定書類から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "株式会社メタプラネットは10月13日、欧州とアジアを中心とする海外市場（米国を除く）で、2031年に満期を迎える転換社債型新株予約権付社債を募集することを決めた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 13,
         "unit": "日",
         "label": "日付（発行を決めた日）"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "2026年10月13日、代表執行役CEOが、欧州及びアジアを中心とする海外市場（但し、米国を除く。）において募集する2031年満期ユーロ円建転換社債型新株予約権付社債",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7K7）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7K7）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "転換社債型新株予約権付社債は、お金を貸した側が、あとで社債をその会社の株に換えることもできる権利の付いた社債である。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "書類によると、この社債の発行で手元に入るお金（手取金）はおよそ519億円で、その使い道も示された。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 519,
         "unit": "億円",
         "label": "手取金（約）"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "本新株予約権付社債の発行による手取金約519億円の使途は、以下を予定している。",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7K7）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7K7）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "投資家に売る値段（発行価格）は、社債の額面の102.5%とされた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 102.5,
         "unit": "%",
         "label": "発行価格（額面に対する割合）"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "本社債の額面金額の102.5％",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7K7）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7K7）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "社債の額面は、満期に返すと約束した金額のことである。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-10-14-001-1",
       "text": "利息の付かない転換社債で資金を集める会社が続けば、株に換えられた分だけ発行済み株式が増え、1株あたりの持ち分が薄まることへの関心が投資家の間で高まる可能性がある。",
       "falsifier": "今後3か月の間、EDINETに出る転換社債型新株予約権付社債の発行の届出が目立って増えなければ、この見方は当てはまらない。",
       "check_metric": "EDINETの臨時報告書のうち、転換社債型新株予約権付社債の発行を理由とするものの件数",
       "check_by": "2027-01-31"
      }
     ],
     "followup": {
      "is_followup": false,
      "first_seen": null,
      "first_seen_edition_id": null,
      "has_new_source": null
     }
    }
   ]
  },
  {
   "section_id": "change",
   "title": "新しい変化",
   "articles": [
    {
     "article_id": "ART-2026-10-14-002",
     "event_id": "EVT-2026-10-14-002",
     "headline": "創薬の研究をする会社が、新株予約権で研究資金を集めると決める（法定書類から）",
     "lines": [
      {
       "line_id": "L-002-01",
       "text": "株式会社Veritas In Silicoは、10月13日の取締役会で新株予約権の発行を決議した。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 13,
         "unit": "日",
         "label": "日付（取締役会で決議した日）"
        }
       ],
       "source_ref": "SRC-004",
       "excerpt": "2026年10月13日付の当社取締役会において発行を決議しております",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7M3）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7M3）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-02",
       "text": "新株予約権は、決められた値段を払えば、会社から新しく発行される株を受け取れる権利である。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-002-03",
       "text": "このうち第五回の新株予約権がすべて使われた場合に渡される株は最大3,000,000株で、10月13日時点の発行済み株式6,487,114株に対して46.25%にあたる。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 3000000,
         "unit": "株",
         "label": "割当株式数の上限（第五回）"
        },
        {
         "value": 6487114,
         "unit": "株",
         "label": "発行済株式数"
        },
        {
         "value": 46.25,
         "unit": "%",
         "label": "発行済株式数に対する割合"
        }
       ],
       "source_ref": "SRC-004",
       "excerpt": "3,000,000株(2026年10月13日現在の発行済株式数 6,487,114株に対する割合：46.25％",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7M3）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7M3）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-04",
       "text": "第五回から第九回までの新株予約権の発行と行使で手元に入る見込みのお金は、合わせて1,773百万円とされた（すべて当初の行使価額で使われたと仮定した額）。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 1773,
         "unit": "百万円",
         "label": "差引手取概算額の合計"
        }
       ],
       "source_ref": "SRC-004",
       "excerpt": "本新株予約権の発行及び割当予定先による本新株予約権の行使によって調達する差引手取概算額は合計1,773百万円となる予定です。",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7M3）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7M3）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-05",
       "text": "使い道は、自社で進めている医薬品候補の開発研究の費用で、1,773百万円とされた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 1773,
         "unit": "百万円",
         "label": "医薬品候補物質の開発研究費用"
        }
       ],
       "source_ref": "SRC-004",
       "excerpt": "自社創薬研究(パイプライン)にて進めている医薬品候補物質の開発研究費用 1,773",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7M3）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7M3）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-06",
       "text": "権利を使うときの値段（行使価額）は株価に合わせて変わるが、第五回の下限は10月9日の終値の50%にあたる213円とされた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 50,
         "unit": "%",
         "label": "終値に対する割合（下限）"
        },
        {
         "value": 213,
         "unit": "円",
         "label": "下限行使価額"
        }
       ],
       "source_ref": "SRC-004",
       "excerpt": "下限行使価額は、2026年10月９日(以下「発行決議日前取引日」という。)の終値の50％に相当する213円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7M3）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z7M3）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-10-14-002-1",
       "text": "医薬品の研究開発を行う小さな会社が、株価に合わせて行使価額が変わる新株予約権で資金を集める場合、株価が下がると集まるお金が見込みより少なくなる可能性がある。",
