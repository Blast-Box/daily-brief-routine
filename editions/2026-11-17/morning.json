 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-11-17-001",
     "event_id": "EVT-2026-11-17-001",
     "headline": "続報：ＣＥホールディングスの臨時株主総会、3,204,500株を1株にまとめる株式併合を賛成の割合98.11%で可決：効力発生は2027年1月15日の予定（法定書類から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "情報・通信業の株式会社ＣＥホールディングスが11月16日に届け出た臨時報告書によると、11月13日の臨時株主総会で、株式併合の議案は賛成の割合98.11%で可決された。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 98.11,
         "unit": "%",
         "label": "株式併合の議案の賛成の割合"
        },
        {
         "value": 150992,
         "unit": "個",
         "label": "株式併合の議案の賛成の議決権の数"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "第１号議案  150,992  941  1,964  （注）  98.11％",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZI5A）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZI5A）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "併合の割合は、3,204,500株を1株にまとめるものである。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 3204500,
         "unit": "株",
         "label": "併合の割合（併合前の株数）"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "当社株式について3,204,500株を１株に併合いたします。",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZI5A）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZI5A）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "株式併合の効力が生じると、同社の発行済株式総数は4株になる。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 4,
         "unit": "株",
         "label": "併合後の発行済株式総数"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "本株式併合の効力が生じた場合には、当社の発行済株式総数は４株となり",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZI5A）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZI5A）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "定款の一部を変える議案も、賛成の割合98.08%で可決された。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 98.08,
         "unit": "%",
         "label": "定款の一部を変える議案の賛成の割合"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "第２号議案  150,952  937  1,964  （注）  98.08％",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZI5A）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZI5A）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "書類によると、株式併合の効力発生日は2027年1月15日で、定款の変更もこの日に効力が生じる。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 15,
         "unit": "日",
         "label": "日付（効力発生日）"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "本株式併合の効力発生日である2027年１月15日に効力が生じるものといたします",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZI5A）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZI5A）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "株式併合は、何株かを1株にまとめる手続きで、まとめる単位に届かない株しか持たない株主は、株主でなくなり、代わりにお金を受け取る。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "株式併合は、公開買付けの後に残った少数の株主から株を集め、会社を非公開にする最後の段階として使われることが多い。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-11-17-001-1",
       "text": "投資ファンドなどが関わる2段階の非公開化では、株主総会での高い賛成の割合が、手続きが予定どおり進む目安になる可能性がある。",
       "falsifier": "効力発生日までに株式併合の手続きが中止・延期されれば、この見方は成り立たない。",
       "check_metric": "EDINETに出る株式併合の中止・延期を届け出る書類の有無",
       "check_by": "2027-01-15"
      }
     ],
     "followup": {
      "is_followup": false,
      "first_seen": null,
      "first_seen_edition_id": null,
      "has_new_source": null
     }
    }
   ]
  },
  {
   "section_id": "change",
   "title": "新しい変化",
   "articles": [
    {
     "article_id": "ART-2026-11-17-002",
     "event_id": "EVT-2026-11-17-002",
     "headline": "情報・通信業のクレスコ、従業員持株会向けに譲渡制限付株式として自己株式69,600株を1株1,960円で処分へ（法定書類から）",
     "lines": [
      {
       "line_id": "L-002-01",
       "text": "株式会社クレスコは11月16日、従業員持株会向けの譲渡制限付株式の制度に基づいて自己株式を処分すると届け出た。処分する株の数は最大69,600株である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 69600,
