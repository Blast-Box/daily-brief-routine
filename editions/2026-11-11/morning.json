   "title": "新しい変化",
   "articles": [
    {
     "article_id": "ART-2026-11-11-002",
     "event_id": "EVT-2026-11-11-002",
     "headline": "小売業の丸井グループ、役員などへの株式報酬の信託に自己株式568,700株を1株2,852円で処分へ（法定書類から）",
     "lines": [
      {
       "line_id": "L-002-01",
       "text": "丸井グループは11月10日、役員や幹部社員に株を渡す信託の仕組みを続けるため、信託に自己株式を処分すると決め、臨時報告書を届け出た。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 568700,
         "unit": "株",
         "label": "件数（信託に処分する株数）"
        }
       ],
       "source_ref": "SRC-007",
       "excerpt": "本自己株式処分により各本信託に処分する当社株式（合計568,700株）",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZCY4）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZCY4）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-02",
       "text": "払込金額は1株につき2,852円で、取締役会の日の前営業日の終値としている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 1,
         "unit": "株",
         "label": "1株あたり"
        },
        {
         "value": 2852,
         "unit": "円",
         "label": "1株あたりの払込金額"
        }
       ],
       "source_ref": "SRC-007",
       "excerpt": "(ii) 募集株式の払込金額　１株につき2,852円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZCY4）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZCY4）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-03",
       "text": "対象となる取締役などは43名、グループの経営幹部社員は294名と書かれている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 43,
         "unit": "名",
         "label": "件数（対象の取締役など）"
        },
        {
         "value": 294,
         "unit": "名",
         "label": "件数（経営幹部社員）"
        }
       ],
       "source_ref": "SRC-007",
       "excerpt": "本取締役会の日における当社の対象取締役等は43名（うち当社の社内取締役3名、当社の執行役員18名、対象子会社の取締役22名）、当社グループ経営幹部社員は294名",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZCY4）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZCY4）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-04",
       "text": "会社が持っている自分の株（自己株式）を信託に渡し、決めた条件を満たした役員や社員に後で株を渡す仕組みを、株式報酬の信託という。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-11-11-002-1",
       "text": "業績に連動した株式報酬を続ける小売業の会社が増えれば、役員の報酬と株主の利害を近づける仕組みが業界で広がる可能性がある。",
       "falsifier": "今後1年の小売業の臨時報告書で、株式報酬の信託の新設・継続の届け出がほとんど見られなければ、この見方は成り立たない。",
       "check_metric": "EDINET 小売業の会社の臨時報告書（株式報酬の信託に関するもの）の件数",
       "check_by": "2027-11-30"
      }
     ],
