 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-11-11-001",
     "event_id": "EVT-2026-11-11-001",
     "headline": "電機のパナソニック ホールディングスの中間期、営業利益は3,632億円で前年同期比120%増：データセンター向けの蓄電システムやAIインフラ向けの部品が伸びる（法定書類から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "パナソニック ホールディングスが11月11日に提出した半期報告書によると、4〜9月の連結売上高は前年同期比7%増えた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 7,
         "unit": "%",
         "label": "連結売上高の前年同期比"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "連結売上高は4兆925億円（前年同期比7％増）となりました",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE3H）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE3H）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "同じ期間の営業利益は3,632億円で、前年同期比120%増えた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 3632,
         "unit": "億円",
         "label": "営業利益"
        },
        {
         "value": 120,
         "unit": "%",
         "label": "営業利益の前年同期比"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "営業利益は3,632億円（前年同期比120％増）",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE3H）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE3H）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "電池を扱うエナジー部門の売上高は6,459億円（前年同期比45%増）で、車載電池は北米工場の販売が増え、産業・民生ではデータセンター向けの蓄電システムの需要に対応したと書かれている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 6459,
         "unit": "億円",
         "label": "エナジー部門の売上高"
        },
        {
         "value": 45,
         "unit": "%",
         "label": "エナジー部門の売上高の前年同期比"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "売上高は、6,459億円（前年同期比45％増）となりました。車載電池は、北米工場の販売増などにより増収となりました。また、産業・民生は、データセンター向けの蓄電システムの旺盛な需要に対応し",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE3H）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE3H）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "部品や工場の機器を扱うインダストリー部門の売上高は6,838億円（前年同期比19%増）で、AIインフラ向けのコンデンサや多層基板材料、半導体製造設備向けの機器の需要が増えたとしている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 6838,
         "unit": "億円",
         "label": "インダストリー部門の売上高"
        },
        {
         "value": 19,
         "unit": "%",
         "label": "インダストリー部門の売上高の前年同期比"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "売上高は、6,838億円（前年同期比19％増）となりました。ＡＩインフラ向け情報通信関連製品（コンデンサ、多層基板材料）及び半導体製造設備向けＦＡ機器（サーボモータ、センサ）の需要拡大により",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE3H）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE3H）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "一方、家電などのスマートライフ部門では、原材料の値上がりなどに加えて、リコール費用190億円を計上した。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 190,
         "unit": "億円",
         "label": "リコール費用"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "原材料高騰等の影響やリコール費用190億円の計上",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE3H）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE3H）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "スマートライフ部門の営業利益は73億円で、前年同期比53%減った。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 73,
         "unit": "億円",
         "label": "スマートライフ部門の営業利益"
        },
        {
         "value": 53,
         "unit": "%",
         "label": "スマートライフ部門の営業利益の前年同期比の減少率"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "前年同期に比べ減益の73億円（前年同期比53％減）となりました",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE3H）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE3H）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "半期報告書は、上場会社が事業年度の前半6か月の成績や財務の状況をまとめて国に届け出る書類である。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-11-11-001-1",
       "text": "AIのためのデータセンターの建設が続く間は、蓄電システムやコンデンサなど、データセンターの電気まわりの部品をつくる電気機器業の売上が伸び続ける可能性がある。",
       "falsifier": "データセンター向けの投資が減り、次の半期報告書で電気機器業の会社がデータセンター向けの需要の減少を書くようになれば、この見方は成り立たない。",
       "check_metric": "電気機器業の会社の次の四半期・半期の報告書にある、データセンター向けの製品の売上の記述",
       "check_by": "2027-02-15"
      }
     ],
