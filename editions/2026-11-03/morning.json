 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-11-03-001",
     "event_id": "EVT-2026-11-03-001",
     "headline": "非鉄金属の住友電気工業の中間期、売上高は2,764,912百万円で16.5%増、営業利益は43.5%増：データセンタ向けの光配線製品などが伸びる（法定書類から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "非鉄金属の住友電気工業は11月2日、2026年4月〜9月の中間期の半期報告書を届け出た。売上高は2,764,912百万円で、前年同期の2,373,461百万円から16.5%増えた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2764912,
         "unit": "百万円",
         "label": "中間期の連結売上高"
        },
        {
         "value": 2373461,
         "unit": "百万円",
         "label": "前年同期の連結売上高"
        },
        {
         "value": 16.5,
         "unit": "%",
         "label": "連結売上高の前年同期比"
        }
       ],
       "source_ref": "SRC-008",
       "excerpt": "売上高は、2,764,912百万円（前年同期2,373,461百万円、16.5％増）",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZAZ3）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZAZ3）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "営業利益は219,567百万円で、前年同期の153,021百万円から43.5%増えた。書類は、中東の影響による原価の上昇はあったが、売上の増加や品種構成の改善、生産性の改善、売値の改善、円安の影響があったと説明している。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 219567,
         "unit": "百万円",
         "label": "中間期の連結営業利益"
        },
        {
         "value": 153021,
         "unit": "百万円",
         "label": "前年同期の連結営業利益"
        },
        {
         "value": 43.5,
         "unit": "%",
         "label": "連結営業利益の前年同期比"
        }
       ],
       "source_ref": "SRC-008",
       "excerpt": "営業利益は219,567百万円（前年同期153,021百万円、43.5％増）",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZAZ3）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZAZ3）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "親会社株主に帰属する中間純利益は159,384百万円で、前年同期の97,938百万円から62.7%増えた。書類は、営業利益などとともに過去最高を更新したと書いている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 159384,
         "unit": "百万円",
         "label": "親会社株主に帰属する中間純利益"
        },
        {
         "value": 97938,
         "unit": "百万円",
         "label": "前年同期の親会社株主に帰属する中間純利益"
        },
        {
         "value": 62.7,
         "unit": "%",
         "label": "中間純利益の前年同期比"
        }
       ],
       "source_ref": "SRC-008",
       "excerpt": "親会社株主に帰属する中間純利益は159,384百万円（前年同期97,938百万円、62.7％増）と、いずれも前年同期を上回り、過去最高を更新しました",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZAZ3）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZAZ3）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "部門別では、情報通信関連事業で、生成AI市場の拡大を背景にデータセンタ向けの光配線製品や光デバイスなどの需要が増え、売上高は201,459百万円と、66,036百万円（48.8%）増えた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 201459,
         "unit": "百万円",
         "label": "情報通信関連事業の売上高"
        },
        {
         "value": 66036,
         "unit": "百万円",
         "label": "情報通信関連事業の売上高の増加額"
        },
        {
         "value": 48.8,
         "unit": "%",
         "label": "情報通信関連事業の売上高の伸び率"
        }
       ],
       "source_ref": "SRC-008",
       "excerpt": "生成AI市場の拡大を背景にデータセンタ向けの光配線製品、光デバイスなどの需要が増加し、売上高は201,459百万円と66,036百万円（48.8％）の増収",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZAZ3）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZAZ3）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "情報通信関連事業の営業利益は61,237百万円で、39,162百万円増えた。書類は、売上の増加に加えて、品種構成や生産性の改善、円安の影響があったとしている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 61237,
         "unit": "百万円",
         "label": "情報通信関連事業の営業利益"
        },
        {
         "value": 39162,
         "unit": "百万円",
         "label": "情報通信関連事業の営業利益の増加額"
        }
       ],
       "source_ref": "SRC-008",
       "excerpt": "営業利益は、売上増加に加えて、品種構成や生産性の改善、円安の影響もあり、61,237百万円と39,162百万円の増益",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZAZ3）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZAZ3）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "半期報告書は、上場企業が事業年度の前半の業績や財政の状態をまとめて届け出る書類である。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "お断り：この紙面は、生成AIを開発するAnthropic社のAI（Claude）が作っている。生成AIの市場に関わる記述では、この立場にあることを明記し、評価は加えない。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-11-03-001-1",
       "text": "データセンタ向けの設備投資が続けば、光ファイバーや光部品を作る非鉄金属・電気機器の業種で、情報通信向けの売上が伸び続ける可能性がある。",
       "falsifier": "次の決算期の書類で、データセンタ向け製品の需要が減ったと書かれれば、この見方は成り立たない。",
       "check_metric": "非鉄金属の会社の有価証券報告書・半期報告書の、情報通信関連の部門の売上高",
