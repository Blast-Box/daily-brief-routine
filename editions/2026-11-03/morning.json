  {
   "section_id": "change",
   "title": "新しい変化",
   "articles": [
    {
     "article_id": "ART-2026-11-03-004",
     "event_id": "EVT-2026-11-03-002",
     "headline": "金属製品のセイワホールディングス、めっき加工の美山理研工業の全株式を取得して子会社に：子会社になる日は11月10日の予定（法定書類から）",
     "lines": [
      {
       "line_id": "L-004-01",
       "text": "金属製品のセイワホールディングスは、2026年11月2日の取締役会で、めっき加工を営む美山理研工業の全株式を取得し、子会社にすることを決議したと、同日に臨時報告書で届け出た。",
       "claimed_mark": "source_number_match",
