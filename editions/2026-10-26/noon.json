 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-10-26-001",
     "event_id": "EVT-2026-10-26-001",
     "headline": "小森コーポレーション、銀行との借入れの枠15,000百万円を全額借りる：純資産を70%以上に保つ条件付き（法定書類から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "コミットメントライン契約は、あらかじめ決めた枠の中で、会社が必要なときに銀行からお金を借りられる約束である。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "小森コーポレーションが10月26日に出した臨時報告書によると、借入れのもとになった契約はコミットメントライン契約で、枠の総額は15,000百万円である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 15000,
         "unit": "百万円",
         "label": "契約の枠の総額"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "① 契約形態　　　　　　　　　　　　　コミットメントライン契約（総額15,000百万円）",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9MV）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9MV）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "実際に借りた金額は15,000百万円で、枠の総額と同じである。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 15000,
         "unit": "百万円",
         "label": "借入金額"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "② 借入金額　　　　　　　　　　　　　15,000百万円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9MV）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9MV）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "返す期限（弁済期限）は2029年10月23日である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 23,
         "unit": "日",
         "label": "日付（弁済期限）"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "③ 弁済期限　　　　　　　　　　　　　2029年10月23日",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9MV）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9MV）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "契約には、純資産の部の金額を、2026年3月期の決算と直前の決算期のうち高いほうの金額の70%以上に保つという条件（財務上の特約）が付いている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 70,
         "unit": "%",
         "label": "純資産の部の金額を保つ割合の下限"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "純資産の部の金額を2026年３月期決算及び直前決算期における純資産の部の金額のいずれか高い金の70％以上に維持すること。",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9MV）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9MV）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "財務上の特約は、お金を借りる会社が守るよう約束する財務の条件で、守れないと、早く返すよう求められることがある。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-10-26-001-1",
       "text": "借入れの枠を大きく使う会社が増えれば、銀行の企業向けの貸出の残高の伸びが続く可能性がある。",
       "falsifier": "日本銀行の貸出・預金動向で、10月の銀行の貸出の前年比の伸びが9月より小さくなれば、この見方は当たらない。",
       "check_metric": "日本銀行 貸出・預金動向（2026年10月分）の銀行計の貸出平残の前年比",
       "check_by": "2026-11-16"
      }
     ],
     "followup": {
      "is_followup": false,
      "first_seen": null,
      "first_seen_edition_id": null,
      "has_new_source": null
     }
    },
    {
     "article_id": "ART-2026-10-26-002",
     "event_id": "EVT-2026-10-26-002",
     "headline": "ＮＥＣキャピタルソリューション、出資の額3,000百万円の投資の組合が特定子会社に：11月上旬の予定（法定書類から）",
     "lines": [
      {
       "line_id": "L-002-01",
       "text": "投資事業有限責任組合は、投資家から集めたお金で会社の株などに投資する、ファンドと呼ばれる仕組みの形である。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-002-02",
       "text": "ＮＥＣキャピタルソリューションが10月26日に出した臨時報告書によると、新しくできた投資事業有限責任組合の出資の額は3,000百万円である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 3000,
         "unit": "百万円",
         "label": "組合の出資の額"
        }
       ],
       "source_ref": "SRC-002",
       "excerpt": "④　出資の額　　　　　　　　3,000百万円",
