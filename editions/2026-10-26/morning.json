   "articles": [
    {
     "article_id": "ART-2026-10-26-002",
     "event_id": "EVT-2026-10-26-002",
     "headline": "米国の政府の口座にお金が集まる：10月21日までの週の平均で952,002百万ドル、銀行が中央銀行に預ける準備預金は59,533百万ドル減る（FRB理事会の統計から）",
     "lines": [
      {
       "line_id": "L-002-01",
       "text": "同じ統計で、米国の財務省が連邦準備銀行に置く口座（TGA）の残高は、10月21日までの週の平均で952,002百万ドルとなり、前の週より68,629百万ドル増えた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 952002,
         "unit": "百万ドル",
         "label": "財務省の口座の週平均"
        },
        {
         "value": 68629,
         "unit": "百万ドル",
         "label": "前の週からの変化"
        }
       ],
       "source_ref": "SRC-005",
       "excerpt": "U.S. Treasury, General Account 952,002 + 68,629",
       "attribution": "出典：FRB理事会「H.4.1 Factors Affecting Reserve Balances of Depository Institutions and Condition Statement of Federal Reserve Banks」（https://www.federalreserve.gov/releases/h41/current/h41.pdf）",
       "processing_note": "FRB理事会「H.4.1 Factors Affecting Reserve Balances of Depository Institutions and Condition Statement of Federal Reserve Banks」（https://www.federalreserve.gov/releases/h41/current/h41.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-02",
       "text": "銀行などが連邦準備銀行に預けている準備預金は2,962,607百万ドルで、前の週より59,533百万ドル減った。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2962607,
         "unit": "百万ドル",
         "label": "準備預金の週平均"
        },
        {
         "value": 59533,
         "unit": "百万ドル",
         "label": "前の週からの減少幅"
        }
       ],
       "source_ref": "SRC-005",
       "excerpt": "Reserve balances with Federal Reserve Banks 2,962,607 - 59,533",
       "attribution": "出典：FRB理事会「H.4.1 Factors Affecting Reserve Balances of Depository Institutions and Condition Statement of Federal Reserve Banks」（https://www.federalreserve.gov/releases/h41/current/h41.pdf）",
       "processing_note": "FRB理事会「H.4.1 Factors Affecting Reserve Balances of Depository Institutions and Condition Statement of Federal Reserve Banks」（https://www.federalreserve.gov/releases/h41/current/h41.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-03",
       "text": "連邦準備銀行が国債を担保に資金を受け入れる取引（リバース・レポ）は327,238百万ドルで、前の週より4,953百万ドル減った。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 327238,
         "unit": "百万ドル",
         "label": "リバース・レポの週平均"
        },
        {
         "value": 4953,
         "unit": "百万ドル",
         "label": "前の週からの減少幅"
        }
       ],
       "source_ref": "SRC-005",
       "excerpt": "Reverse repurchase agreements12 327,238 - 4,953",
       "attribution": "出典：FRB理事会「H.4.1 Factors Affecting Reserve Balances of Depository Institutions and Condition Statement of Federal Reserve Banks」（https://www.federalreserve.gov/releases/h41/current/h41.pdf）",
       "processing_note": "FRB理事会「H.4.1 Factors Affecting Reserve Balances of Depository Institutions and Condition Statement of Federal Reserve Banks」（https://www.federalreserve.gov/releases/h41/current/h41.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-04",
       "text": "銀行が連邦準備銀行の窓口から借りるお金（プライマリー・クレジット）は8,935百万ドルで、前の週より2,377百万ドル減った。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 8935,
         "unit": "百万ドル",
         "label": "窓口からの借入れの週平均"
        },
        {
         "value": 2377,
         "unit": "百万ドル",
         "label": "前の週からの減少幅"
        }
       ],
       "source_ref": "SRC-005",
       "excerpt": "Primary credit 8,935 - 2,377",
       "attribution": "出典：FRB理事会「H.4.1 Factors Affecting Reserve Balances of Depository Institutions and Condition Statement of Federal Reserve Banks」（https://www.federalreserve.gov/releases/h41/current/h41.pdf）",
       "processing_note": "FRB理事会「H.4.1 Factors Affecting Reserve Balances of Depository Institutions and Condition Statement of Federal Reserve Banks」（https://www.federalreserve.gov/releases/h41/current/h41.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-05",
       "text": "世の中に出回っているお札などの通貨は2,486,258百万ドルで、前の週より2,006百万ドル減り、1年前より68,670百万ドル増えた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2486258,
         "unit": "百万ドル",
         "label": "出回っている通貨の週平均"
        },
        {
         "value": 2006,
         "unit": "百万ドル",
         "label": "前の週からの減少幅"
        },
        {
         "value": 68670,
         "unit": "百万ドル",
         "label": "1年前の同じ週からの変化"
        }
       ],
       "source_ref": "SRC-005",
       "excerpt": "Currency in circulation11 2,486,258 - 2,006 + 68,670",
       "attribution": "出典：FRB理事会「H.4.1 Factors Affecting Reserve Balances of Depository Institutions and Condition Statement of Federal Reserve Banks」（https://www.federalreserve.gov/releases/h41/current/h41.pdf）",
       "processing_note": "FRB理事会「H.4.1 Factors Affecting Reserve Balances of Depository Institutions and Condition Statement of Federal Reserve Banks」（https://www.federalreserve.gov/releases/h41/current/h41.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-06",
       "text": "財務省の口座は、米国の政府が税金や国債で集めたお金を置いておく、中央銀行の中の口座である。",
