 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-11-10-001",
     "event_id": "EVT-2026-11-10-001",
     "headline": "リユース事業の大黒屋ホールディングス、親会社が持つ株を1株31円で買う公開買付けに賛同：前営業日の終値73円より57.53%低い値段で、上場は続く見込み（法定書類から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "大黒屋ホールディングスの株を対象にした公開買付けで、買付けの値段は1株31円である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 31,
         "unit": "円",
         "label": "買付け等の価格（1株あたり）"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "買付け等の価格  当社株式１株につき　金31円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE9C）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE9C）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "買付けの期間は、2026年11月10日から12月8日までの20営業日である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 20,
         "unit": "営業日",
         "label": "買付け等の期間"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "買付け等の期間  2026年11月10日（火曜日）から2026年12月８日（火曜日）まで（20営業日）",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE9C）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE9C）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "買付者は、2026年8月27日に、大黒屋ホールディングスの株の取得と所有を主な目的として設立された会社である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 27,
         "unit": "日",
         "label": "日付（買付者の設立日）"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "公開買付者は、2026年８月27日に、当社の株券等の取得及び所有を主たる目的として設立された",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE9C）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE9C）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "31円という値段は、公表日の前営業日（11月6日）の終値73円に対して57.53%のディスカウント（割り引き）をした値段だと書かれている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 31,
         "unit": "円",
         "label": "買付け等の価格"
        },
        {
         "value": 73,
         "unit": "円",
         "label": "11月6日の終値"
        },
        {
         "value": 57.53,
         "unit": "%",
         "label": "終値に対するディスカウントの率"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "本公開買付価格31円は、本公開買付けの実施についての公表日の前営業日である2026年11月６日の東京証券取引所スタンダード市場における当社株式の終値73円に対して57.53％",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE9C）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE9C）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "書類を出した日の前営業日（11月9日）の終値75円と比べると、58.67%のディスカウントになる。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 75,
         "unit": "円",
         "label": "11月9日の終値"
        },
        {
         "value": 58.67,
         "unit": "%",
         "label": "終値に対するディスカウントの率"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "2026年11月９日の東京証券取引所スタンダード市場における当社株式の終値75円に対して、58.67％のディスカウントをした価格",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE9C）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE9C）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "買付けが成立しても買付者が持つ株は485,055,672株（所有割合64.38%）にとどまる予定で、上場は維持される見込みだと書かれている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 485055672,
         "unit": "株",
         "label": "買付け後に買付者が持つ予定の株数"
        },
        {
         "value": 64.38,
         "unit": "%",
         "label": "所有割合"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "当社株式485,055,672株（所有割合：64.38％）にとどまる予定です。したがって、本公開買付けの成立後も、当社株式の東京証券取引所スタンダード市場への上場は維持される見込みです",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE9C）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE9C）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "書類には、以前の第三者割当増資の払込金額は1株9円で、今回の買付けの値段との差は22円だとも書かれている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 9,
         "unit": "円",
         "label": "第三者割当増資の払込金額（1株あたり）"
        },
        {
         "value": 22,
         "unit": "円",
         "label": "買付けの値段との差"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "本第三者割当増資の払込金額は当社株式１株当たり９円であり、本公開買付価格と22円の差異があり",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE9C）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZE9C）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-08",
       "text": "公開買付けは、決めた値段と期間で、株主から株を買い集める手続きである。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
