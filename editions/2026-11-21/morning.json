 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-11-21-001",
     "event_id": "EVT-2026-11-21-001",
     "headline": "続報：ＳＢＩホールディングスの海外の転換社債、株に替えるときの値段は当初1株3,248円に決まる（法定書類から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "ＳＢＩホールディングスが11月20日に出した訂正臨時報告書で、この社債を株に替えるときの値段（転換価額）は、当初1株3,248円と決まった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 3248,
         "unit": "円",
         "label": "転換価額（当初）"
        }
       ],
       "source_ref": "SRC-002",
       "excerpt": "転換価額は、当初、3,248円とする。",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ4H）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ4H）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "投資家が払う値段（発行価格）は、社債の額面金額の102.5％とされた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 102.5,
         "unit": "%",
         "label": "発行価格（額面金額に対する割合）"
        }
       ],
       "source_ref": "SRC-002",
       "excerpt": "本社債の額面金額の102.5％",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ4H）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ4H）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "付ける新株予約権の数は15,000個（額面1,000万円ごとに1個）で、ほかに紛失などに備える代わりの社債券の分が加わる。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 15000,
         "unit": "個",
         "label": "新株予約権の総数"
        },
        {
         "value": 1000,
         "unit": "万円",
         "label": "1個あたりの額面金額"
        }
       ],
       "source_ref": "SRC-002",
       "excerpt": "15,000個及び代替新株予約権付社債券に係る本社債の額面金額合計額を1,000万円で除した個数の合計数",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ4H）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ4H）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "転換社債型新株予約権付社債は、決められた値段で発行会社の株に替えることができる権利が付いた社債である。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "株に替えられると、その分だけ会社の発行済みの株が増える。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-11-21-001-1",
       "text": "金融業の会社が、利息の付かない転換社債で海外から大きな資金を集める動きが続けば、国内の金融業の資金の集め方が、借入から株に替わりうる社債へと広がる可能性がある。",
       "falsifier": "今後3か月の間に、国内の金融業の会社による転換社債の発行の届け出が1件も出なければ、この見方は成り立たない。",
       "check_metric": "EDINETの臨時報告書のうち、金融業の会社による新株予約権付社債の発行の件数",
       "check_by": "2027-02-26"
      }
     ],
     "followup": {
      "is_followup": false,
      "first_seen": null,
      "first_seen_edition_id": null,
      "has_new_source": null
     }
    }
   ]
  },
  {
   "section_id": "change",
   "title": "新しい変化",
   "articles": [
    {
     "article_id": "ART-2026-11-21-002",
     "event_id": "EVT-2026-11-21-002",
     "headline": "Ｓａｎｓａｎ、社内規程の管理サービスのKiteRaを子会社に：取得の対価は合計で概算7,134百万円（法定書類から）",
     "lines": [
      {
       "line_id": "L-002-01",
       "text": "Ｓａｎｓａｎは、社内規程の管理サービス「KiteRa」を運営する株式会社KiteRaを子会社にすると決め、11月20日に臨時報告書を出した。取得の対価は、普通株式と各種の種類株式で7,124百万円とされている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 7124,
         "unit": "百万円",
         "label": "普通株式及び各種種類株式の取得価額"
        }
       ],
       "source_ref": "SRC-007",
       "excerpt": "普通株式及び各種種類株式 7,124百万円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ74）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ74）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-02",
       "text": "取得の対価は、合計で概算7,134百万円である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 7134,
         "unit": "百万円",
         "label": "取得の対価の合計（概算額）"
        }
       ],
       "source_ref": "SRC-007",
       "excerpt": "合計（概算額） 7,134百万円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ74）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ74）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-03",
       "text": "同社は2022年にKiteRa社へ出資しており、議決権の割合は3.3%だった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 3.3,
         "unit": "%",
         "label": "出資時の議決権所有割合"
        }
       ],
       "source_ref": "SRC-007",
       "excerpt": "当社は2022年にKiteRa社へ出資しており（議決権所有割合3.3%）",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ74）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ74）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-04",
       "text": "KiteRa社の売上高は、2024年6月期から2026年6月期までの3期で、670百万円、1,034百万円、1,564百万円と増えている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 670,
         "unit": "百万円",
         "label": "売上高（2024年6月期）"
        },
        {
         "value": 1034,
         "unit": "百万円",
         "label": "売上高（2025年6月期）"
        },
        {
         "value": 1564,
         "unit": "百万円",
         "label": "売上高（2026年6月期）"
        }
       ],
       "source_ref": "SRC-007",
       "excerpt": "売上高 670百万円 1,034百万円 1,564百万円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ74）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ74）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
