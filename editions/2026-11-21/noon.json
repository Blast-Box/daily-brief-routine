 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-11-21-001",
     "event_id": "EVT-2026-11-21-001",
     "headline": "続報：伊藤忠商事、文化シヤッターの株について大量保有報告書を提出：株券等保有割合は18.97%、取得資金の合計は27,389,400千円（法定書類から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "伊藤忠商事が11月20日に提出した大量保有報告書によると、同社は11月13日に文化シヤッターの普通株式13,694,600株を市場外の取引で取得した。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 13694600,
         "unit": "株",
         "label": "取得した株式の数"
        }
       ],
       "source_ref": "SRC-008",
       "excerpt": "2026年11月13日  株券（普通株式）  13,694,600  18.97  市場外  取得",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ3F）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ3F）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "この取得の単価の欄には、1株2,000円と書かれている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2000,
         "unit": "円",
         "label": "取得の単価（1株あたり）"
        }
       ],
       "source_ref": "SRC-008",
       "excerpt": "株券（普通株式）  13,694,600  18.97  市場外  取得  2000",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ3F）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ3F）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "報告書に書かれた伊藤忠商事の株券等保有割合は18.97%である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 18.97,
         "unit": "%",
         "label": "株券等保有割合"
        }
       ],
       "source_ref": "SRC-008",
       "excerpt": "上記提出者の株券等保有割合（％）（AB／（AD＋AE－AF）×100）  18.97",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ3F）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ3F）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "割合の計算に使われた文化シヤッターの発行済株式等総数は、11月13日現在で72,196,487株である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 72196487,
         "unit": "株",
         "label": "発行済株式等総数"
        }
       ],
       "source_ref": "SRC-008",
       "excerpt": "発行済株式等総数（株・口）（2026年11月13日現在）  AD  72,196,487",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ3F）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ3F）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "取得に使った資金の合計は27,389,400千円と書かれている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 27389400,
         "unit": "千円",
         "label": "取得資金合計"
        }
       ],
       "source_ref": "SRC-008",
       "excerpt": "取得資金合計（千円）（AG+AH+AI）  27,389,400",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ3F）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ3F）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "このうち自己資金の額の欄も27,389,400千円と書かれている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 27389400,
         "unit": "千円",
         "label": "自己資金額"
        }
       ],
       "source_ref": "SRC-008",
       "excerpt": "自己資金額（AG）（千円）  27,389,400",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ3F）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ3F）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "保有の目的は、11月13日付の資本業務提携契約に基づく提携の強化と、文化シヤッターを伊藤忠商事の持分法適用関連会社とすることだと書かれている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 13,
         "unit": "日",
         "label": "日付（資本業務提携契約の締結）"
        }
       ],
       "source_ref": "SRC-008",
       "excerpt": "提出者が発行者との間で締結した2026年11月13日付資本業務提携契約（以下「本資本業務提携契約」といいます。）に基づく資本業務提携の強化、および発行者を提出者の持分法適用関連会社とすることを目的とした株式の保有です。",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ3F）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ3F）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-08",
       "text": "報告書には、伊藤忠商事が11月13日に取得した株と合わせて、発行済株式総数（自己株式を除く）の20%程度まで、文化シヤッターの普通株式を取得する予定だとも書かれている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 20,
         "unit": "%",
         "label": "取得を予定する株式の割合（発行済株式総数に対する目安）"
        }
       ],
       "source_ref": "SRC-008",
       "excerpt": "発行者の発行済株式総数（自己株式を除く。）の20%程度の発行者の普通株式を取得することを予定しております。",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ3F）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZJ3F）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-09",
       "text": "大量保有報告書は、上場会社の株を一定の割合を超えて持った人や会社が、持っている量や目的を届け出る書類である。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-10",
       "text": "持分法適用関連会社とは、出資している会社の利益のうち出資の割合に当たる分を、出資した側の決算に取り込む関係にある会社のことである。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-11",
       "text": "株券等保有割合と議決権の割合は、計算に使う分母が違うため、同じ株数でも数字が一致しないことがある。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-11-21-001-1",
