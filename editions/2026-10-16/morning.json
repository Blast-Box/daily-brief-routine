 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-10-16-001",
     "event_id": "EVT-2026-10-16-001",
     "headline": "ククレブ・アドバイザーズが、財務上の特約が付いた3,180百万円の借入の契約を結ぶと決める（法定書類から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "ククレブ・アドバイザーズは、10月15日の取締役会で、財務上の特約が付いた借入の契約（金銭消費貸借契約）を結ぶことを決めたと届け出た。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 15,
         "unit": "日",
         "label": "日付（取締役会の決議日）"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "当社は2026年10月15日開催の取締役会において、財務上の特約が付された金銭消費貸借契約",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8DL）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8DL）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "借入金額は3,180百万円である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 3180,
         "unit": "百万円",
         "label": "借入金額"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "借入金額  3,180百万円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8DL）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8DL）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "返し方は、元金を毎月約13百万円ずつ返し、残りを返済期日にまとめて返す形と書かれている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 13,
         "unit": "百万円",
         "label": "毎月の元金の返済額（約）"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "元金均等分割返済（月額約13百万円）、残額は返済期日に一括返済",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8DL）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8DL）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "返済期日は2029年10月27日の予定である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 27,
         "unit": "日",
         "label": "日付（返済期日）"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "返済期日  2029年10月27日（予定）",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8DL）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8DL）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "財務上の特約の1つめは、2027年8月期以降の各決算日の連結純資産額を、2026年8月期の連結純資産額の75%以上に保つことである。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 75,
         "unit": "%",
         "label": "連結純資産額を保つ割合の下限"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "2026年８月期の連結純資産額の75%以上を維持すること",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8DL）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8DL）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "財務上の特約は、借り手が決められた条件を守れなくなったときに、貸し手が返済を早めるよう求めることができる取り決めとして使われることが多い。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "金利が市場の動きに合わせて変わる「変動金利」の借入では、市場の金利が上がると、払う利息も増える。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-10-16-001-1",
       "text": "政策金利の引き上げが続けば、変動金利で大きく借りる不動産関連の会社の利払いの負担が増える可能性がある。",
       "falsifier": "日本銀行が今後の会合で政策金利を据え置き、短期の市場金利が上がらなければ、この見方は当たらない。",
       "check_metric": "日本銀行 金融政策決定会合の結果（無担保コールレートの誘導目標）",
       "check_by": "2026-10-31"
      }
     ],
     "followup": {
      "is_followup": false,
      "first_seen": null,
      "first_seen_edition_id": null,
      "has_new_source": null
     }
    }
   ]
  },
  {
   "section_id": "change",
   "title": "新しい変化",
   "articles": [
    {
     "article_id": "ART-2026-10-16-002",
     "event_id": "EVT-2026-10-16-002",
     "headline": "ヒューマンクリエイションHDの子会社で取引先の従業員による不正な取引、特別損失400百万円（法定書類から）",
     "lines": [
      {
       "line_id": "L-002-01",
       "text": "ヒューマンクリエイションホールディングスは、2026年9月期の連結決算に特別損失400百万円を計上したと届け出た。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 400,
         "unit": "百万円",
         "label": "特別損失の額"
        }
       ],
       "source_ref": "SRC-002",
       "excerpt": "当該事象の発生により、2026年９月期の連結決算に特別損失400百万円を計上いたしました。",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8HV）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8HV）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-02",
       "text": "理由は、連結子会社のコスモピアで取引先の従業員による不正な取引があり、回収できる額を今の時点で合理的に見積もるのが難しいためと書かれている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 9,
         "unit": "月",
         "label": "日付（特別損失を計上する決算期末の月）"
        }
       ],
       "source_ref": "SRC-002",
       "excerpt": "現時点において回収可能額を合理的に見積もることが困難であることから、2026年９月期末で特別損失として計上",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8HV）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8HV）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-03",
       "text": "特別損失は、ふだんの事業とは別に、その期だけ臨時に生じた損失を表す決算の項目である。",
       "claimed_mark": "explainer",
