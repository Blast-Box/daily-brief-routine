   "articles": [
    {
     "article_id": "ART-2026-11-05-001",
     "event_id": "EVT-2026-11-05-001",
     "headline": "ネット広告のアドウェイズ、伊藤忠商事と資本業務提携：伊藤忠商事は取締役1名を指名でき、議決権20%を保つための引受権も（法定書類から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "ネット広告のアドウェイズは、伊藤忠商事と資本業務提携の契約を結び、伊藤忠商事が同社の取締役1名を指名する権利を持つと届け出た。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 1,
         "unit": "名",
         "label": "伊藤忠商事が指名できる取締役の人数"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "伊藤忠商事は、当社の取締役1名を指名する権利を有しており",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBCS）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBCS）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "アドウェイズが、伊藤忠商事の議決権の割合が20%を下回ることになる株の発行などをする場合、伊藤忠商事はその割合を保つのに必要な数の株の発行や処分を受ける権利を持つ。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 20,
         "unit": "%",
         "label": "伊藤忠商事が保つ議決権の割合"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "当該議決権保有割合20％を維持するために必要な数の当社普通株式の発行又は処分を受ける権利を有する",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBCS）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBCS）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "アドウェイズは、投資総額2億円以上のネット広告以外の新しい事業に加わることなどについて、伊藤忠商事に前もって知らせることになる。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2,
         "unit": "億円",
         "label": "事前に知らせる新規事業の投資総額の基準"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "(4) 投資総額2億円以上のインターネット広告事業以外の新規事業への参画",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBCS）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBCS）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "資本業務提携は、一方の会社が相手の会社に出資したうえで、仕事の上でも協力すると決める取り決めである。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "第三者割当は、特定の相手に新しい株などを割り当てて、その相手からお金を払い込んでもらうやり方である。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-11-05-001-1",
       "text": "大手の総合商社がネット広告の会社に出資して提携する形が続けば、広告業の中で、商社の取引先や海外の拠点を使って販路を広げる例が増える可能性がある。",
       "falsifier": "今後1年ほどの間に、総合商社とネット広告の会社の資本業務提携が新たに届け出られなければ、この見方は広がりを持たない。",
       "check_metric": "EDINETの臨時報告書のうち、総合商社を相手とする資本業務提携の件数",
       "check_by": "2027-11-05"
      }
     ],
     "followup": {
      "is_followup": false,
      "first_seen": null,
      "first_seen_edition_id": null,
      "has_new_source": null
     }
    },
    {
     "article_id": "ART-2026-11-05-002",
     "event_id": "EVT-2026-11-05-002",
     "headline": "クラシル、連結子会社のALホールディングスの全株式を譲渡へ：約5億円を特別利益に計上する見込み（法定書類から）",
     "lines": [
      {
       "line_id": "L-002-01",
       "text": "クラシルは、連結子会社のALホールディングスの全株式を株式会社Yoyogi Animation Groupに譲渡する契約を結び、株式譲渡の実行日を2026年12月28日の予定とした。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 28,
         "unit": "日",
         "label": "日付（株式譲渡の実行予定日）"
        }
       ],
       "source_ref": "SRC-002",
       "excerpt": "株式譲渡実行日  2026年12月28日（予定）",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBCQ）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBCQ）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-02",
       "text": "この譲渡で、個別決算と連結決算のそれぞれで約5億円を関係会社株式売却益として特別利益に計上する見込みだが、実際の額は譲渡の日の子会社の純資産などで変わる可能性があるとしている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 5,
         "unit": "億円",
         "label": "関係会社株式売却益の見込み額"
        }
       ],
       "source_ref": "SRC-002",
       "excerpt": "個別決算において約5億円、連結決算において約5億円を、それぞれ関係会社株式売却益として特別利益に計上する見込み",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBCQ）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBCQ）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-03",
       "text": "特別利益は、本業とは別に、その期だけ一時的に生じた利益を示す項目である。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-11-05-002-1",
       "text": "子会社の株を売って一時的な利益を計上する会社が続けば、情報・通信業の中で、本業に集中するための事業の組み替えが進んでいる可能性がある。",
       "falsifier": "子会社の売却を届け出る臨時報告書が情報・通信業で目立って増えなければ、この見方は当たらない。",
