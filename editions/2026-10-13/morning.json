 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-10-13-001",
     "event_id": "EVT-2026-10-13-001",
     "headline": "電力と海運の大手が、脱炭素への移行に使う社債の条件を決める（法定書類から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "社債は、会社が投資家からお金を借りるために出す債券で、決めた利率で利息を払い、期限が来たら元本を返す。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "「トランジションボンド」は、二酸化炭素の排出を減らす方向への移行に使うお金を集めるための社債を指す呼び名である。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "日本郵船の第54回無担保社債は、トランジションボンドと名付けられている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 54,
         "unit": "回",
         "label": "社債の回号"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "日本郵船株式会社第54回無担保社債（社債間限定同順位特約付）（トランジションボンド）",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z784）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z784）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "日本郵船の期間3年の社債の総額は62億円。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 6200000000,
         "unit": "円",
         "label": "期間3年の社債の券面総額"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "券面総額又は振替社債の総額（円）  金6,200,000,000円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z784）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z784）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "この期間3年の社債の利率は年2.415%。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2.415,
         "unit": "%",
         "label": "期間3年の社債の利率"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "利率（％）  年2.415％",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z784）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z784）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "同じく期間5年の社債の総額は87億円。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 8700000000,
         "unit": "円",
         "label": "期間5年の社債の券面総額"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "券面総額又は振替社債の総額（円）  金8,700,000,000円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z784）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z784）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "期間5年の社債の利率は年2.781%。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2.781,
         "unit": "%",
         "label": "期間5年の社債の利率"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "利率（％）  年2.781％",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z784）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z784）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-08",
       "text": "期間10年の社債の総額は78億円。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 7800000000,
         "unit": "円",
         "label": "期間10年の社債の券面総額"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "券面総額又は振替社債の総額（円）  金7,800,000,000円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z784）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z784）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-09",
       "text": "期間10年の社債の利率は年3.586%。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 3.586,
         "unit": "%",
         "label": "期間10年の社債の利率"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "利率（％）  年3.586％",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z784）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z784）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-10",
       "text": "日本郵船は、差し引きの手取り概算額22,566百万円を、2029年10月末までに全額、中期経営計画の「船舶燃料転換シナリオ」で予定するLNG燃料船に関する支出に充てる予定としている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 22566,
         "unit": "百万円",
         "label": "差引手取概算額"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "差引手取概算額22,566百万円は、2029年10月末までに、全額を中期経営計画に掲げた「2050年に向けた船舶燃料転換シナリオ」で予定する投資（新規支出及び既存支出のリファイナンス）であるLNG燃料船に関する支出に充当する予定",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z784）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z784）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-11",
       "text": "関西電力の第587回無担保社債も、トランジション・ボンドと名付けられている。",
       "claimed_mark": "source_number_match",
