 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-10-15-001",
     "event_id": "EVT-2026-10-15-001",
     "headline": "日銀の審議委員が熊本で挨拶：「中立金利は1%より相応に上」、今後も利上げを適時に",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "日本銀行の審議委員が10月15日、熊本県金融経済懇談会で挨拶し、その要旨を日本銀行が公表した。日本銀行は9月の決定会合で、政策金利を1.25%に引き上げている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 1.25,
         "unit": "%",
         "label": "政策金利（9月の決定会合で引き上げた後の水準）"
        }
       ],
       "source_ref": "SRC-010",
       "excerpt": "政策金利を、９月の決定会合で 1.25％へ引き上げました",
       "attribution": "出典：日本銀行「わが国の経済・物価情勢と金融政策 ── 熊本県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261015a1.pdf）",
       "processing_note": "日本銀行「わが国の経済・物価情勢と金融政策 ── 熊本県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261015a1.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "中立金利とは、景気や物価を温めも冷やしもしない、ちょうど中間の金利の水準のことで、直接は観察できず推計で幅をもって示される。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "挨拶の中で審議委員は、名目の中立金利の幅を「+1.1%程度から+2.5%程度」と示した。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 1.1,
         "unit": "%",
         "label": "名目の中立金利の幅の下限"
        },
        {
         "value": 2.5,
         "unit": "%",
         "label": "名目の中立金利の幅の上限"
        }
       ],
       "source_ref": "SRC-010",
       "excerpt": "中立金利のレンジは＋1.1％程度から＋2.5％程度の範囲になります",
       "attribution": "出典：日本銀行「わが国の経済・物価情勢と金融政策 ── 熊本県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261015a1.pdf）",
       "processing_note": "日本銀行「わが国の経済・物価情勢と金融政策 ── 熊本県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261015a1.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "そのうえで、中立金利の水準は、推計の幅の下限の目安である1%よりは「相応に上」だと考えている、と述べた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 1,
         "unit": "%",
         "label": "中立金利の推計の幅の下限の目安"
        }
       ],
       "source_ref": "SRC-010",
       "excerpt": "中立金利の水準は、推計レンジの下限の目安である１％よりは相応に上であ",
       "attribution": "出典：日本銀行「わが国の経済・物価情勢と金融政策 ── 熊本県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261015a1.pdf）",
       "processing_note": "日本銀行「わが国の経済・物価情勢と金融政策 ── 熊本県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261015a1.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "報道によると、審議委員は講演で「利上げに過度に慎重になることはない」と述べ、政策金利の引き上げを続ける姿勢を強調した。",
       "claimed_mark": "reported_unverified",
       "numbers": [],
       "source_ref": "SRC-011",
       "excerpt": null,
       "attribution": "出典：東京新聞「東京新聞の検索結果（2026-10-15）」（https://www.tokyo-np.co.jp/article/521719）",
       "processing_note": "東京新聞「東京新聞の検索結果（2026-10-15）」（https://www.tokyo-np.co.jp/article/521719）をもとに本サイト作成",
       "mark": "reported_unverified",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "挨拶では、住宅ローンについて、住宅を買う20代・30代は比較的賃金の伸びが高いとし、足もとの金利上昇が働く世代の消費を必ずしも冷やすわけではないとの考えを示した。ただし、これまでの利上げが家計に及ぼす影響は丁寧に確認したい、とも述べた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 20,
         "unit": "代",
         "label": "住宅購入を行う年代（下）"
        },
        {
         "value": 30,
         "unit": "代",
         "label": "住宅購入を行う年代（上）"
        }
       ],
       "source_ref": "SRC-010",
       "excerpt": "住宅購入を行う 20 代、30 代は比較的賃金の伸びが高く、",
       "attribution": "出典：日本銀行「わが国の経済・物価情勢と金融政策 ── 熊本県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261015a1.pdf）",
