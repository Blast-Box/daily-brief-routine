 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-10-15-001",
     "event_id": "EVT-2026-10-15-001",
     "headline": "スズキが、従業員20,028名に自社の株を渡すと決める（法定書類から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "スズキは2026年10月14日の取締役会で、社員向けの株式報酬の制度に基づき、自社が持つ株を社員に渡す「自己株式の処分」を決議したと、臨時報告書で届け出た。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 14,
         "unit": "日",
         "label": "日付（取締役会の決議日）"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "2026年10月14日開催の当社取締役会において当社普通株式の処分（以下、「本自己株式処分」といいます。）を行うことを決議いたしました",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z5SH）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z5SH）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "譲渡制限付株式は、会社が社員や役員に株を渡すが、決められた期間は売ったり人に渡したりできないようにした株である。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "株を受け取る相手は、同社の従業員20,028名とされている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 20028,
         "unit": "名",
         "label": "株を受け取る従業員の人数"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "当社の従業員20,028名",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z5SH）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z5SH）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "株1つあたりの発行価格（払込金額）は2,059.5円とされている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2059.5,
         "unit": "円",
         "label": "株1つあたりの発行価格"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "発行価格　2,059.5円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z5SH）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z5SH）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "発行価額の総額は824,953,320円である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 824953320,
         "unit": "円",
         "label": "発行価額の総額"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "発行価額の総額　824,953,320円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z5SH）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z5SH）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "この処分は、会社が社員に支給する金銭の報酬（合計824,953,320円）を、株の払い込みにあてる「現物出資」の形で行われる。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 824953320,
         "unit": "円",
         "label": "社員に支給する金銭報酬債権の合計"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "割当対象者に対して支給される金銭報酬債権合計金824,953,320円を出資の目的として、現物出資の方法により行われるものです",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z5SH）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z5SH）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "会社が持っている自社の株を社員に渡す場合、新しく株を刷る場合と違って、発行済みの株の総数は増えない。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-10-15-001-1",
       "text": "製造業の大手で、社員に株を報酬として渡す制度を広く全社員に広げる動きが続く可能性がある。",
       "falsifier": "今後半年の間に、同様の全社員向けの株式報酬についての臨時報告書が製造業でほとんど出なければ、この見方は成り立たない。",
       "check_metric": "EDINETに提出される、従業員を対象とした自己株式処分の臨時報告書の件数",
       "check_by": "2027-04-30"
      }
     ],
     "followup": {
      "is_followup": false,
      "first_seen": null,
      "first_seen_edition_id": null,
      "has_new_source": null
     }
    }
   ]
  },
  {
   "section_id": "change",
   "title": "新しい変化",
   "articles": [
    {
     "article_id": "ART-2026-10-15-002",
     "event_id": "EVT-2026-10-15-002",
     "headline": "シードで、公開買付けの結果、海外の会社が議決権の43.29%を持つ主要株主に（法定書類から）",
     "lines": [
      {
       "line_id": "L-002-01",
       "text": "シードは、ラックスシェア・プレシジョン・ケイマン・リミテッドが2026年8月27日から10月13日まで行った公開買付けにより、主要株主に異動があると臨時報告書で届け出た。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 13,
         "unit": "日",
         "label": "日付（公開買付けの終了日）"
        }
       ],
       "source_ref": "SRC-005",
       "excerpt": "が2026年８月27日から2026年10月13日まで実施した当社の普通株式に対する公開買付け",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z82F）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z82F）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-02",
       "text": "公開買付けは、決めた値段と期間で、株主から株を買い集める手続きである。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-002-03",
       "text": "異動後、買付けをした会社が持つ議決権の数は131,025個、全体に対する割合は43.29%となる。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 131025,
         "unit": "個",
         "label": "異動後の所有議決権の数"
        },
        {
         "value": 43.29,
         "unit": "%",
         "label": "異動後の総株主の議決権に対する割合"
        }
       ],
       "source_ref": "SRC-005",
       "excerpt": "異動後  131,025個  43.29％",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z82F）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z82F）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-04",
       "text": "主要株主は、株主総会で投票できる権利（議決権）を一定以上の割合で持つ大株主のことである。",
       "claimed_mark": "explainer",
       "numbers": [],
