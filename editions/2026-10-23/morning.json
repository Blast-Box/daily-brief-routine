 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-10-23-001",
     "event_id": "EVT-2026-10-23-001",
     "headline": "米国の企業が短い期間お金を借りるCP：10月21日の残高は1,502.6（10億ドル単位）、格付けで金利に差（FRB理事会の統計から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "CP（コマーシャルペーパー）は、企業が数日から数か月の短い期間お金を借りるために出す証書である。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "FRB理事会（米国の中央銀行の理事会）は、米国のCPの金利と残高の統計を10月22日に掲載した。データは10月21日時点のものである。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 21,
         "unit": "日",
         "label": "日付（データの時点）"
        },
        {
         "value": 22,
         "unit": "日",
         "label": "日付（掲載日）"
        }
       ],
       "source_ref": "SRC-011",
       "excerpt": "Data as of October 21, 2026Posted October 22, 2026",
       "attribution": "出典：Federal Reserve Board「Commercial Paper Rates and Outstanding Summary」（https://www.federalreserve.gov/releases/cp/）",
       "processing_note": "Federal Reserve Board「Commercial Paper Rates and Outstanding Summary」（https://www.federalreserve.gov/releases/cp/）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "季節による動きをならした残高（単位は10億ドル）は、10月21日（水曜日）時点で合計1,502.6だった。内訳は、金融以外の企業が380.5、金融機関が617.7、資産を裏付けにしたCPが504.4である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 1502.6,
         "unit": "10億ドル",
         "label": "CP残高の合計（季節調整済み）"
        },
        {
         "value": 380.5,
         "unit": "10億ドル",
         "label": "金融以外の企業のCP残高"
        },
        {
         "value": 617.7,
         "unit": "10億ドル",
         "label": "金融機関のCP残高"
        },
        {
         "value": 504.4,
         "unit": "10億ドル",
         "label": "資産を裏付けにしたCPの残高"
        }
       ],
       "source_ref": "SRC-011",
       "excerpt": "Oct. 21  1,502.6  380.5  306.4  74.1  617.7  276.5  341.2  504.4",
       "attribution": "出典：Federal Reserve Board「Commercial Paper Rates and Outstanding Summary」（https://www.federalreserve.gov/releases/cp/）",
       "processing_note": "Federal Reserve Board「Commercial Paper Rates and Outstanding Summary」（https://www.federalreserve.gov/releases/cp/）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "1週間前の10月14日時点は、合計1,479.9（10億ドル単位）だった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 1479.9,
         "unit": "10億ドル",
         "label": "CP残高の合計（季節調整済み、10月14日の週）"
        }
       ],
       "source_ref": "SRC-011",
       "excerpt": "Oct. 14  1,479.9",
       "attribution": "出典：Federal Reserve Board「Commercial Paper Rates and Outstanding Summary」（https://www.federalreserve.gov/releases/cp/）",
       "processing_note": "Federal Reserve Board「Commercial Paper Rates and Outstanding Summary」（https://www.federalreserve.gov/releases/cp/）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "10月21日の金利は、格付けの高い（AA）金融以外の企業が30日の期間で借りる場合が年3.98%、格付けがそれより低い（A2/P2）金融以外の企業が30日の期間で借りる場合が年4.18%だった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 3.98,
         "unit": "%",
         "label": "AA格の金融以外の企業の30日物の金利"
        },
        {
         "value": 4.18,
         "unit": "%",
         "label": "A2/P2格の金融以外の企業の30日物の金利"
        }
       ],
       "source_ref": "SRC-011",
       "excerpt": "Oct. 21  3.88  3.93  3.94  3.98  4.04  n.a.  4.01  4.04  4.11  4.18",
       "attribution": "出典：Federal Reserve Board「Commercial Paper Rates and Outstanding Summary」（https://www.federalreserve.gov/releases/cp/）",
       "processing_note": "Federal Reserve Board「Commercial Paper Rates and Outstanding Summary」（https://www.federalreserve.gov/releases/cp/）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "同じ日の、格付けの高い金融以外の企業が1日だけ借りる金利は年3.88%だった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 3.88,
         "unit": "%",
         "label": "AA格の金融以外の企業の1日物の金利"
        }
       ],
       "source_ref": "SRC-011",
       "excerpt": "Oct. 21  3.88  3.93",
       "attribution": "出典：Federal Reserve Board「Commercial Paper Rates and Outstanding Summary」（https://www.federalreserve.gov/releases/cp/）",
       "processing_note": "Federal Reserve Board「Commercial Paper Rates and Outstanding Summary」（https://www.federalreserve.gov/releases/cp/）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "同じ日の、格付けの高い（AA）資産を裏付けにしたCPの30日物の金利は年4.07%だった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 4.07,
         "unit": "%",
         "label": "AA格の資産を裏付けにしたCPの30日物の金利"
        }
       ],
       "source_ref": "SRC-011",
       "excerpt": "Oct. 21  3.87  3.90  3.94  n.a.  4.14  n.a.  3.92  3.95  4.00  4.07",
       "attribution": "出典：Federal Reserve Board「Commercial Paper Rates and Outstanding Summary」（https://www.federalreserve.gov/releases/cp/）",
       "processing_note": "Federal Reserve Board「Commercial Paper Rates and Outstanding Summary」（https://www.federalreserve.gov/releases/cp/）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-08",
       "text": "一般に、格付けが低い企業ほど、お金を貸す側は高い金利を求める。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-10-23-001-1",
       "text": "米国で企業の短期の借入れが増え続ければ、日本の大手銀行の米国でのドル資金の調達の費用にも影響する可能性がある。",
       "falsifier": "10月28日の週以降、CP残高の合計が2週続けて減れば、この見方は弱まる。",
       "check_metric": "FRB理事会 Commercial Paper の残高（季節調整済み）の合計",
       "check_by": "2026-11-06"
      }
     ],
     "followup": {
      "is_followup": false,
      "first_seen": null,
      "first_seen_edition_id": null,
      "has_new_source": null
     }
    }
   ]
