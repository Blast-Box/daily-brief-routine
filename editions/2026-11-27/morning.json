 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-11-27-001",
     "event_id": "EVT-2026-11-27-001",
     "headline": "日本銀行の審議委員が山梨で講演：消費者物価の上振れリスクに注意が必要と説明、家事用消耗品は10月に前年比12.0%上昇（日本銀行）",
     "lines": [
      {
       "line_id": "L-001-02",
       "text": "日本銀行の政策委員会の審議委員が11月26日に山梨県で行った挨拶の要旨によると、日本銀行は9月の金融政策決定会合で、短期の政策金利の誘導目標を1.25%程度とした。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 1.25,
         "unit": "%",
         "label": "短期政策金利の誘導目標"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "９月の金融政策決定会合では1.25％程",
       "attribution": "出典：日本銀行「わが国の経済・物価情勢と金融政策 ── 山梨県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261126a1.pdf）",
       "processing_note": "日本銀行「わが国の経済・物価情勢と金融政策 ── 山梨県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261126a1.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "審議委員は、消費者物価（生鮮食品を除く）の前年比が足もとで2%台前半になっていると説明した。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2,
         "unit": "%",
         "label": "消費者物価（除く生鮮食品）の前年比の水準（2%台前半）"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "足もとでは２％台前半となっています",
       "attribution": "出典：日本銀行「わが国の経済・物価情勢と金融政策 ── 山梨県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261126a1.pdf）",
       "processing_note": "日本銀行「わが国の経済・物価情勢と金融政策 ── 山梨県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261126a1.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "教育無償化などの政策の影響（特殊要因）を除いた試算では、足もとで3%台半ばまで上昇しているとした。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 3,
         "unit": "%",
         "label": "特殊要因を除いた消費者物価の前年比の水準（3%台半ば）"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "足もとでは３％台半ばまで上昇しています",
       "attribution": "出典：日本銀行「わが国の経済・物価情勢と金融政策 ── 山梨県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261126a1.pdf）",
       "processing_note": "日本銀行「わが国の経済・物価情勢と金融政策 ── 山梨県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261126a1.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "品目別では、ポリ袋やラップなどを含む家事用消耗品が、10月に前年比12.0%上昇したと挙げた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 12.0,
         "unit": "%",
         "label": "家事用消耗品の10月の前年比"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "家事用消耗品が、10月には前年比で＋12.0％",
       "attribution": "出典：日本銀行「わが国の経済・物価情勢と金融政策 ── 山梨県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261126a1.pdf）",
       "processing_note": "日本銀行「わが国の経済・物価情勢と金融政策 ── 山梨県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261126a1.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "ノートパソコンやタブレット端末などを含む教養娯楽用耐久財も、前年比8.2%上昇したと挙げた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 8.2,
         "unit": "%",
         "label": "教養娯楽用耐久財の前年比"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "が前年比で＋8.2％となるなど",
       "attribution": "出典：日本銀行「わが国の経済・物価情勢と金融政策 ── 山梨県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261126a1.pdf）",
       "processing_note": "日本銀行「わが国の経済・物価情勢と金融政策 ── 山梨県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261126a1.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "中立金利（景気を温めも冷やしもしない金利の水準）について、審議委員は、以前に「2%前後の領域にあるのではないか」と述べ、その後の政策変更や指標、企業の声を踏まえてもその考えは変わっていないとした。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2,
         "unit": "%",
         "label": "中立金利についての審議委員の見方（2%前後）"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "中立金利について、私は、以前、２％前後の領域にあるのではないかと申し上げましたが",
       "attribution": "出典：日本銀行「わが国の経済・物価情勢と金融政策 ── 山梨県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261126a1.pdf）",
       "processing_note": "日本銀行「わが国の経済・物価情勢と金融政策 ── 山梨県金融経済懇談会における挨拶要旨 ──」（https://www.boj.or.jp/about/press/koen_2026/data/ko261126a1.pdf）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-08",
       "text": "政策金利が上がると、銀行が貸し出しや預金に付ける金利も上がりやすい。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-11-27-001-1",
       "text": "物価の上振れへの警戒が続けば、銀行業では貸出の金利の見直しが進み、借入れの多い業種では利払いの負担が増える可能性がある。",
       "falsifier": "12月の金融政策決定会合で政策金利が据え置かれ、その後も引き上げの議論が広がらなければ、この見方は弱まる。",
       "check_metric": "日本銀行 12月の金融政策決定会合の公表文（短期政策金利の誘導目標）",
       "check_by": "2026-12-31"
      }
     ],
