       "line_id": "L-004-05",
       "text": "持分法は、一部の株だけを持つ関連会社の利益や損失のうち、持ち分に当たる分を自社の決算に取り込む方法である。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
