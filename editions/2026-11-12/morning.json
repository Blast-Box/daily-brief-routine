   "articles": [
    {
     "article_id": "ART-2026-11-12-001",
     "event_id": "EVT-2026-11-12-001",
     "headline": "電子部品の北陸電気工業、投資ファンドが関わる会社による1株4,180円の公開買付けに賛同：非公開化が目的（法定書類から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "抵抗器などの電子部品をつくる北陸電気工業は、自社の株を1株4,180円で買い付ける公開買付けについて、意見表明報告書を届け出た。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 4180,
         "unit": "円",
         "label": "1株あたりの買付けの価格"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "普通株式１株につき　金4,180円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZF2B）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZF2B）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "公開買付けは、決めた値段と期間で、株主から株を買い集める手続きである。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "買付けの期間は、2026年11月11日から12月23日までの30営業日である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 30,
         "unit": "営業日",
         "label": "買付けの期間の営業日数"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "2026年11月11日（水曜日）から2026年12月23日（水曜日）まで（30営業日）",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZF2B）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZF2B）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "同社は2026年11月10日の取締役会で、この公開買付けに賛同する意見を表明すると決めた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 10,
         "unit": "日",
         "label": "日付（取締役会）"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "当社は、2026年11月10日開催の当社取締役会において、下記「(2）意見の根拠及び理由」に記載の根拠及び理由に基づき、本公開買付けに賛同する旨の意見を表明する",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZF2B）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZF2B）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "買付けの価格は、公表の前の営業日の終値2,432円に71.88%を上乗せした水準である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2432,
         "unit": "円",
         "label": "公表の前の営業日の終値"
        },
        {
         "value": 71.88,
         "unit": "%",
         "label": "終値に対する上乗せの割合"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "2026年11月９日の東京証券取引所スタンダード市場における当社株式の終値2,432円に対して71.88％",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZF2B）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZF2B）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "買い付ける株の数の下限は5,232,600株（所有割合66.67%）で、応募がこれに届かなければ買付けは行われない。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 5232600,
         "unit": "株",
         "label": "買付予定数の下限"
        },
        {
         "value": 66.67,
         "unit": "%",
         "label": "下限の所有割合"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "買付予定数の下限を5,232,600株（所有割合：66.67％）と設定",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZF2B）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZF2B）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "株主のフェローテックは、持っている1,048,800株（所有割合13.36%）を応募する契約を結んだ。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 1048800,
         "unit": "株",
         "label": "応募を約束した株数"
        },
        {
         "value": 13.36,
         "unit": "%",
         "label": "応募を約束した株の所有割合"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "本応募合意株式の全て（1,048,800株、所有割合：13.36％）について、本公開買付けに応募する",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZF2B）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZF2B）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-08",
       "text": "非公開化とは、株式市場での売り買いをやめ、上場をやめることを指す。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-11-12-001-1",
       "text": "電子部品の業界では、データセンターや車の電動化に向けた投資を進めるため、上場をやめて投資ファンドの支援を受ける形の再編が続く可能性がある。",
       "falsifier": "今後半年の間に、電子部品の会社を対象にした非公開化の公開買付けが1件も出なければ、この見方は成り立たない。",
       "check_metric": "EDINETに提出される電気機器の会社の意見表明報告書の件数",
       "check_by": "2027-05-31"
      }
     ],
     "followup": {
      "is_followup": false,
      "first_seen": null,
      "first_seen_edition_id": null,
