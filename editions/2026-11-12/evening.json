   "articles": [
    {
     "article_id": "ART-2026-11-12-002",
     "event_id": "EVT-2026-11-12-002",
     "headline": "ネットワーク監視のアイビーシー、オリックス系の会社による1株1,490円の公開買付けに賛同：最初の提案の1,300円から引き上げ（法定書類から）",
     "lines": [
      {
       "line_id": "L-002-01",
       "text": "アイビーシーが11月12日に出した意見表明報告書によると、同社の株を対象にした公開買付けの値段は1株1,490円である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 1490,
         "unit": "円",
         "label": "買付け等の価格（1株）"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "買付け等の価格  普通株式１株につき　金1,490円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZGL2）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZGL2）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-08",
       "text": "アイビーシーは、11月11日の取締役会で、この公開買付けに賛同する意見を表明することを決めたと書かれている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 11,
         "unit": "日",
         "label": "日付（取締役会の決議日）"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "当社は、2026年11月11日開催の当社取締役会において、下記「(2）意見の根拠及び理由」に記載の根拠及び理由に基づき、本公開買付けに賛同の意見を表明する",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZGL2）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZGL2）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-02",
       "text": "買付けの期間は、11月12日から12月24日までの30営業日と書かれている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 30,
         "unit": "営業日",
         "label": "買付け等の期間"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "2026年11月12日（木曜日）から2026年12月24日（木曜日）まで（30営業日）",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZGL2）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZGL2）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-03",
       "text": "買付予定数の下限は2,508,200株と書かれている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2508200,
         "unit": "株",
         "label": "買付予定数の下限"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "買付予定数の下限  2,508,200株（注１）",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZGL2）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZGL2）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-04",
       "text": "アイビーシーは、2002年10月に、ネットワーク環境の可視化と性能分析を事業目的として設立された会社だと書かれている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2002,
         "unit": "年",
         "label": "日付（設立の年）"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "2002年10月にネットワーク環境におけるマルチベンダーの可視化及び性能分析を事業目的として設立され",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZGL2）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
