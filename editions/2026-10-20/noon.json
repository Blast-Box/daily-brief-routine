 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-10-20-001",
     "event_id": "EVT-2026-10-20-001",
     "headline": "国が20年でお金を借りる国債の入札：平均の利回りは3.723%、利率は年3.8%（財務省）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "財務省は10月20日、国が20年かけて返す借金の証書「20年利付国債（第198回）」の入札の結果を公表した。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 198,
         "unit": "回",
         "label": "国債の回号"
        }
       ],
       "source_ref": "SRC-008",
       "excerpt": "20年利付国債（第198回）の入札結果",
       "attribution": "出典：財務省「20年利付国債（第198回）の入札結果」（https://www.mof.go.jp/jgbs/auction/calendar/nyusatsu/resul20261020.htm）",
       "processing_note": "財務省「20年利付国債（第198回）の入札結果」（https://www.mof.go.jp/jgbs/auction/calendar/nyusatsu/resul20261020.htm）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "国債は、国が投資家からお金を借りるときに出す証書で、決まった利息を払い、期限が来たら元のお金を返す。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "今回の国債に付く利息の割合（表面利率）は、年3.8%と決まった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 3.8,
         "unit": "%",
         "label": "表面利率（年）"
        }
       ],
       "source_ref": "SRC-008",
       "excerpt": "表面利率 年3.8パーセント",
       "attribution": "出典：財務省「20年利付国債（第198回）の入札結果」（https://www.mof.go.jp/jgbs/auction/calendar/nyusatsu/resul20261020.htm）",
       "processing_note": "財務省「20年利付国債（第198回）の入札結果」（https://www.mof.go.jp/jgbs/auction/calendar/nyusatsu/resul20261020.htm）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "買い手が受け取る利回りは、落札した分の平均で3.723%だった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 3.723,
         "unit": "%",
         "label": "募入平均利回り"
        }
       ],
       "source_ref": "SRC-008",
       "excerpt": "（募入平均利回り） （3.723％）",
       "attribution": "出典：財務省「20年利付国債（第198回）の入札結果」（https://www.mof.go.jp/jgbs/auction/calendar/nyusatsu/resul20261020.htm）",
       "processing_note": "財務省「20年利付国債（第198回）の入札結果」（https://www.mof.go.jp/jgbs/auction/calendar/nyusatsu/resul20261020.htm）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "落札した分のうち、いちばん高い利回りは3.729%だった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 3.729,
         "unit": "%",
         "label": "募入最高利回り"
        }
       ],
       "source_ref": "SRC-008",
       "excerpt": "（募入最高利回り） （3.729％）",
       "attribution": "出典：財務省「20年利付国債（第198回）の入札結果」（https://www.mof.go.jp/jgbs/auction/calendar/nyusatsu/resul20261020.htm）",
       "processing_note": "財務省「20年利付国債（第198回）の入札結果」（https://www.mof.go.jp/jgbs/auction/calendar/nyusatsu/resul20261020.htm）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "落札した値段の平均（額面100円あたり）は100円87銭だった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 100,
         "unit": "円",
         "label": "募入平均価格（円の部分）"
        },
        {
         "value": 87,
         "unit": "銭",
         "label": "募入平均価格（銭の部分）"
        }
       ],
       "source_ref": "SRC-008",
       "excerpt": "(5)募入平均価格 100円87銭",
       "attribution": "出典：財務省「20年利付国債（第198回）の入札結果」（https://www.mof.go.jp/jgbs/auction/calendar/nyusatsu/resul20261020.htm）",
       "processing_note": "財務省「20年利付国債（第198回）の入札結果」（https://www.mof.go.jp/jgbs/auction/calendar/nyusatsu/resul20261020.htm）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "国債の値段が上がると、買い手が受け取る利回りは下がる。値段と利回りは逆に動く。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-08",
       "text": "この国債は令和8年10月21日に発行され、令和28年9月20日に返される。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 21,
         "unit": "日",
         "label": "日付（発行日）"
        }
       ],
       "source_ref": "SRC-008",
       "excerpt": "発行日 令和8年10月21日",
       "attribution": "出典：財務省「20年利付国債（第198回）の入札結果」（https://www.mof.go.jp/jgbs/auction/calendar/nyusatsu/resul20261020.htm）",
       "processing_note": "財務省「20年利付国債（第198回）の入札結果」（https://www.mof.go.jp/jgbs/auction/calendar/nyusatsu/resul20261020.htm）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-10-20-001-1",
       "text": "20年の国債の利回りが4%を下回る水準で続けば、満期の長いお金を預かって国債で運用する保険業では、新しく買う国債の利回りが前年より高い状態が続く可能性がある。",
       "falsifier": "次回以降の20年国債の入札で、平均利回りが前年同時期の水準を下回れば、この見方は成り立たない。",
       "check_metric": "財務省 20年利付国債の入札結果の募入平均利回り",
       "check_by": "2026-12-31"
      },
      {
       "inference_id": "INF-2026-10-20-001-2",
       "text": "長い期間の国の借入の利回りが3%台後半にあることは、銀行業が長い期間で貸すお金の金利にも反映される可能性がある。",
       "falsifier": "日本銀行の貸出約定平均金利（長期）が今後3か月で下がれば、この見方は成り立たない。",
       "check_metric": "日本銀行 貸出約定平均金利（新規・長期）",
       "check_by": "2027-01-31"
      }
     ],
     "followup": {
      "is_followup": false,
      "first_seen": null,
      "first_seen_edition_id": null,
      "has_new_source": null
     }
    }
   ]
  },
  {
   "section_id": "change",
   "title": "新しい変化",
   "articles": [
    {
     "article_id": "ART-2026-10-20-002",
     "event_id": "EVT-2026-10-20-002",
     "headline": "がんの治療薬をつくるステラファーマ、海外の投資会社に新しい株1,000,000株と新株予約権を割り当てる（法定書類から）",
     "lines": [
      {
       "line_id": "L-002-01",
       "text": "ステラファーマは、2026年10月19日の取締役会で、特定の相手に新しい株を割り当てる「第三者割当」による募集を決めたと届け出た。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 19,
         "unit": "日",
         "label": "日付（取締役会の決議）"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "は、2026年10月19日開催の取締役会決議によります。",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8U4）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z8U4）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-02",
       "text": "第三者割当は、会社が決めた相手だけに新しい株を買ってもらい、お金を集める方法である。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-002-03",
       "text": "割り当てる新しい株は1,000,000株で、発行価額の総額は373,000,000円と書かれている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 1000000,
         "unit": "株",
         "label": "割り当てる株式数"
        },
        {
         "value": 373000000,
