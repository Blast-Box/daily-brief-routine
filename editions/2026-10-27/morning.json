   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-10-27-001",
     "event_id": "EVT-2026-10-27-001",
     "headline": "乳製品の雪印メグミルク、社債を出すための枠40,000百万円を届け出（法定書類から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "雪印メグミルクは、社債を出すための枠を前もって届けておく発行登録書を提出し、発行予定額を40,000百万円とした。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 40000,
         "unit": "百万円",
         "label": "社債の発行予定額"
        }
       ],
       "source_ref": "SRC-004",
       "excerpt": "発行予定額　40,000百万円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9H9）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9H9）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "発行できる期間は、発行登録の効力が生じる予定の2026年11月3日から2年を経過する日までとしている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2,
         "unit": "年",
         "label": "発行予定期間の長さ"
        }
       ],
       "source_ref": "SRC-004",
       "excerpt": "この発行登録書による発行登録の効力発生予定日（2026年11月３日）から２年を経過する日（2028年11月２日）まで",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9H9）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9H9）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "発行登録は、社債などを出す前に枠を届けておき、実際に出すときの手続きを短くする仕組みである。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "社債は、会社が投資家からお金を借りるために出す証券で、決めた利息を払い、期限が来たら元本を返す。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-10-27-001-1",
       "text": "食料品の会社が社債の枠を広げる動きは、借りたお金の返済や設備への投資の資金を、銀行の借入れ以外からも集める流れの一つである可能性がある。",
       "falsifier": "枠を届けた後の2年間に食料品の会社の社債の発行が増えなければ、この見方は成り立たない。",
       "check_metric": "EDINETの発行登録追補書類（食料品の会社の社債の発行条件）",
       "check_by": "2028-11-02"
      }
     ],
     "followup": {
      "is_followup": false,
      "first_seen": null,
      "first_seen_edition_id": null,
      "has_new_source": null
     }
    }
   ]
