     "event_id": "EVT-2026-10-27-002",
     "headline": "カラオケ店などの鉄人化ホールディングス、金融機関から200,000,000円を借り入れへ：期間5年、10月29日に実行予定（法定書類から）",
     "lines": [
      {
       "line_id": "L-002-01",
       "text": "鉄人化ホールディングスは、金融機関から200,000,000円を借り入れると臨時報告書で届け出た。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 200000000,
         "unit": "円",
         "label": "借入金額"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "借入金額 200,000,000円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9WH）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9WH）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-02",
       "text": "金利は、1か月のTiborレートに1.1%を上乗せする変動金利としている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 1,
         "unit": "か月",
         "label": "基準にするTiborの期間"
        },
        {
         "value": 1.1,
         "unit": "%",
         "label": "上乗せする金利"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "変動金利　1ヶ月Tiborレート＋1.1％",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9WH）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9WH）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-03",
       "text": "借りる期間は5年。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 5,
         "unit": "年",
         "label": "借入期間"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "借入期間 ５年",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9WH）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9WH）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-04",
       "text": "借入れの実行日は2026年10月29日の予定。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 29,
         "unit": "日",
         "label": "日付（借入実行日）"
        }
       ],
       "source_ref": "SRC-003",
       "excerpt": "借入実行日 2026年10月29日（予定）",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9WH）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100Z9WH）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-05",
       "text": "この借入れにより、長期借入金200百万円を計上するとしている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 200,
