   "articles": [
    {
     "article_id": "ART-2026-10-31-002",
     "event_id": "EVT-2026-10-31-002",
     "headline": "財務省、9月29日〜10月28日の為替介入の額は0円と公表（財務省）",
     "lines": [
      {
       "line_id": "L-002-01",
