 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-10-31-001",
     "event_id": "EVT-2026-10-31-001",
     "headline": "価格比較サイトのカカクコムへの公開買付け、買い手候補2社の価格の上げ合いが続く：Kamgras １は1株3,683円に、別の会社は3,700円を予定（法定書類から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "公開買付けは、決めた値段と期間で、株主から株を買い集める手続きである。買い付けられる側の会社は、意見表明報告書という書類で、その公開買付けへの意見を示す。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "カカクコムが10月30日に出した訂正意見表明報告書によると、同社に公開買付けをしているKamgras １株式会社は、10月28日付で買付価格を1株3,682円から3,683円に引き上げた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 3682,
         "unit": "円",
         "label": "変更前の買付価格（1株）"
        },
        {
         "value": 3683,
         "unit": "円",
         "label": "変更後の買付価格（1株）"
        },
        {
         "value": 1,
         "unit": "株",
         "label": "価格の単位の株数"
        }
       ],
       "source_ref": "SRC-005",
       "excerpt": "2026年10月28日付で公開買付届出書の訂正届出書を提出し、本公開買付価格を１株当たり3,682円から3,683円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZB1Z）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZB1Z）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "新しい買付価格3,683円は、公開買付けを公表した日の前の営業日（2026年5月11日）の終値2,774円より32.77%高い。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2774,
         "unit": "円",
         "label": "公表日の前の営業日の終値"
        },
        {
         "value": 32.77,
         "unit": "%",
         "label": "終値に対する上乗せの割合"
        }
       ],
       "source_ref": "SRC-005",
       "excerpt": "2026年５月11日の終値2,774円に対して32.77％のプレミアム",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZB1Z）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZB1Z）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "買付けの期間は2026年5月13日から11月12日までで、125営業日にわたる。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 125,
         "unit": "営業日",
         "label": "買付けの期間の長さ"
        }
       ],
       "source_ref": "SRC-005",
       "excerpt": "買付け等の期間 2026年５月13日から2026年11月12日まで（125営業日）",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZB1Z）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZB1Z）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "一方、別の会社（BCPE Blitz Cayman, L.P.の名義）も公開買付けを予定しており、10月26日付の発表で、予定する買付価格を3,597円から3,700円に変えると決めた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 3597,
         "unit": "円",
         "label": "別の会社の変更前の予定買付価格"
        },
        {
         "value": 3700,
         "unit": "円",
         "label": "別の会社の変更後の予定買付価格"
        }
       ],
       "source_ref": "SRC-005",
       "excerpt": "本提案者は公開買付価格（本提案者）を3,597円から3,700円に変更することを決定したとのことです",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZB1Z）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZB1Z）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "この別の会社が、KDDIが応募しないという合意ができることを条件として示している価格は、3,720円のまま変わっていない。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 3720,
         "unit": "円",
         "label": "条件付きの予定買付価格"
        }
       ],
       "source_ref": "SRC-005",
       "excerpt": "条件付き公開買付価格（本提案者）は3,720円から変更はないとのことです",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZB1Z）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZB1Z）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "カカクコムは、株主や新株予約権を持つ人が応募するかどうかはそれぞれの判断に委ねるとした2026年7月2日付の意見を、変えていないとしている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2,
         "unit": "日",
         "label": "日付（意見を示した日）"
        }
       ],
       "source_ref": "SRC-005",
       "excerpt": "本新株予約権者の皆様のご判断に委ねる旨の2026年７月２日付の意見に変更はありません",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZB1Z）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZB1Z）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-10-31-001-1",
       "text": "1つの会社に複数の買い手候補が現れると、買付価格が少しずつ引き上げられる状態が続く可能性がある。",
       "falsifier": "買付けの期間の末日（11月12日）までに、どちらの買い手候補も買付価格を変えなければ、この見方は成り立たない。",
       "check_metric": "EDINETに出る公開買付届出書の訂正届出書と、公開買付報告書に書かれた買付価格",
       "check_by": "2026-11-13"
      }
     ],
