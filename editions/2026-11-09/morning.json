 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-11-09-001",
     "event_id": "EVT-2026-11-09-001",
     "headline": "電動工具のマキタの中間期、円安で売上収益は9.6%増：現地通貨では前年並み、国内部門の営業利益は25.6%減（法定書類から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "電動工具のマキタの中間期（2026年4月〜9月）の売上収益は、現地通貨で見ると前年並みだったが、円安の影響で前年同期比9.6%増の414,713百万円になった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 9.6,
         "unit": "%",
         "label": "売上収益の前年同期比"
        },
        {
         "value": 414713,
         "unit": "百万円",
         "label": "売上収益"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "現地通貨ベースでは前年並みでしたが、円安現地通貨高の影響により売上収益が前年同期比9.6％増の414,713百万円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBPE）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBPE）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "海外で売った代金を円に直して計算するため、円安になると、現地での売れ行きが同じでも円での売上は大きくなる。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "営業利益は、米国の関税が還付されて原価率が改善したことなどから、前年同期比23.0%増の63,335百万円だった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 23.0,
         "unit": "%",
         "label": "営業利益の前年同期比"
        },
        {
         "value": 63335,
         "unit": "百万円",
         "label": "営業利益"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "米国関税の還付により原価率が改善したことなどから、営業利益は前年同期比23.0％増の63,335百万円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBPE）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBPE）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "地域別の売上では、欧州は建築・建設市場が低調だったものの、主要国での円安の影響で前年同期比8.2%増の202,665百万円になった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 8.2,
         "unit": "%",
         "label": "欧州の売上の前年同期比"
        },
        {
         "value": 202665,
         "unit": "百万円",
         "label": "欧州の売上"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "建築・建設市場は低調に推移しましたが、主要国での円安現地通貨高の影響により、前年同期比8.2％増の202,665百万円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBPE）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBPE）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "北米は、住宅投資の需要が弱い一方でインフラ関連の投資が堅調で、前年同期比17.9%増の46,691百万円だった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 17.9,
         "unit": "%",
         "label": "北米の売上の前年同期比"
        },
        {
         "value": 46691,
         "unit": "百万円",
         "label": "北米の売上"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "前年同期比17.9％増の46,691百万円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBPE）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBPE）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "中近東・アフリカは、中東情勢の緊迫化やエネルギー価格の上昇が経済活動を押し下げ、前年同期比9.8%減の9,149百万円だった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 9.8,
         "unit": "%",
         "label": "中近東・アフリカの売上の前年同期比（減少）"
        },
        {
         "value": 9149,
         "unit": "百万円",
         "label": "中近東・アフリカの売上"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "中東情勢の緊迫化やエネルギー価格上昇などが経済活動の下押し要因となり、前年同期比9.8％減の9,149百万円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBPE）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBPE）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "会社の部門の分け方で見ると、日本の部門の営業利益は、原価率の悪化などで前年同期比25.6%減の16,314百万円だった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 25.6,
         "unit": "%",
         "label": "日本セグメントの営業利益の前年同期比（減少）"
        },
        {
         "value": 16314,
         "unit": "百万円",
         "label": "日本セグメントの営業利益"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "日本セグメントの営業利益は、原価率の悪化などにより前年同期比25.6％減の16,314百万円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBPE）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBPE）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-11-09-001-1",
       "text": "円安が続く間は、海外での売上が大きい機械・工具の会社では、現地での販売数量が伸びなくても円で見た売上が増えやすい可能性がある。",
       "falsifier": "2026年10〜12月に円高が進み、海外売上の大きい機械業の会社の円換算の売上が前年同期を下回れば、この見方は成り立たない。",
       "check_metric": "日本銀行が公表する円の対ドル相場と、機械業の会社の2026年10〜12月期を含む決算の為替の影響額",
       "check_by": "2027-02-26"
      }
     ],
