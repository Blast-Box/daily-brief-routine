   "articles": [
    {
     "article_id": "ART-2026-11-15-001",
     "event_id": "EVT-2026-11-15-001",
     "headline": "保険業のアドバンスクリエイト、不適切な会計処理の疑いで過去の決算を訂正：特別調査費用449,743千円などを特別損失に（法定書類から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "保険業のアドバンスクリエイトは11月13日に臨時報告書を出し、自社と子会社の過去の広告取引やソフトウェアの資産計上などで不適切な会計処理の疑いが見つかった件の調査と決算の訂正に伴い、特別調査費用449,743千円と過年度訂正に伴う費用128,549千円を計上したと届け出た。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 449743,
         "unit": "千円",
         "label": "特別調査費用"
        },
        {
         "value": 128549,
         "unit": "千円",
         "label": "過年度訂正に伴う費用"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "特別調査費用449,743千円及び過年度訂正に伴う費用128,549千円を計上いたしました",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZHVR）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZHVR）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "書類には、固定資産の収益性の低下などに伴う減損損失240,755千円も計上したと書かれている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 240755,
         "unit": "千円",
         "label": "減損損失"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "固定資産の収益性の低下等に伴う減損損失240,755千円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZHVR）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZHVR）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "このほか、債務保証損失引当金繰入額26,264千円、賃貸借契約解約損22,167千円、リース解約損4,032千円を計上した。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 26264,
         "unit": "千円",
         "label": "債務保証損失引当金繰入額"
        },
        {
         "value": 22167,
         "unit": "千円",
         "label": "賃貸借契約解約損"
        },
        {
         "value": 4032,
         "unit": "千円",
         "label": "リース解約損"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "債務保証損失引当金繰入額26,264千円、賃貸借契約解約損22,167千円及びリース解約損4,032千円を計上いたしました",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZHVR）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZHVR）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "特別損失は、ふだんの営業とは別に、その期だけ一時的に生じた損失をまとめて示す項目である。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "過去の決算に誤りが見つかると、会社はさかのぼって数字を直した書類を出し直す。これを「過年度決算の訂正」という。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-11-15-001-1",
       "text": "過去の決算の訂正が続くと、保険業の会社の間で、広告取引などの会計の扱いを見直す動きが広がる可能性がある。",
       "falsifier": "同じ業界の他の会社から、広告取引の会計処理を見直したという届け出が出なければ、この見方は当たらない。",
       "check_metric": "EDINETに出る保険業の会社の臨時報告書・訂正報告書の件数",
       "check_by": "2027-02-15"
      }
     ],
     "followup": {
      "is_followup": false,
      "first_seen": null,
      "first_seen_edition_id": null,
      "has_new_source": null
     }
    },
    {
     "article_id": "ART-2026-11-15-002",
     "event_id": "EVT-2026-11-15-002",
     "headline": "ＣＲＧホールディングス、子会社が持つ株の値下がりで投資有価証券評価損95百万円を特別損失に（法定書類から）",
     "lines": [
      {
       "line_id": "L-002-01",
       "text": "ＣＲＧホールディングスは11月13日に臨時報告書を出し、子会社のＣＲＧインベストメントが持つ株のうち実質的な価値が大きく下がったものについて、投資有価証券評価損95百万円を連結決算の特別損失に計上したと届け出た。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 95,
         "unit": "百万円",
         "label": "投資有価証券評価損（連結）"
        }
       ],
       "source_ref": "SRC-004",
       "excerpt": "減損処理による投資有価証券評価損95百万円を特別損失として、連結財務諸表に計上いたしました",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZHR1）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZHR1）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-02",
       "text": "あわせて親会社は、その子会社への貸付金に対する貸倒引当金繰入額95百万円を営業外費用として計上した。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 95,
         "unit": "百万円",
         "label": "貸倒引当金繰入額"
        }
       ],
       "source_ref": "SRC-004",
       "excerpt": "貸付金に対する貸倒引当金繰入額95百万円を営業外費用として計上いたしました",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZHR1）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZHR1）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-002-03",
       "text": "書類の影響額の欄では、連結財務諸表の投資有価証券評価損は95百万円とされている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 95,
         "unit": "百万円",
