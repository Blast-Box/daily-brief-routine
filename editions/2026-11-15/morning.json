 "sections": [
  {
   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-11-15-001",
     "event_id": "EVT-2026-11-15-001",
     "headline": "食料品のかどや製油への1株2,655円の公開買付け、期間は11月26日まで延長：投資会社が全株を持つ会社が非公開化をめざす（法定書類から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "食料品のかどや製油は11月13日、自社の株への公開買付けについて、意見を書いた報告書の訂正を届け出た。書類には、買付けの期間を11月26日まで延ばし、合計47営業日にしたと書かれている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 26,
         "unit": "日",
         "label": "日付（期間の最終日）"
        },
        {
         "value": 47,
         "unit": "営業日",
         "label": "件数（買付け期間の営業日数）"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "2026年11月26日まで延長し、合計47営業日としたとのことです",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZH5I）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZH5I）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "買付けの値段は、かどや製油の普通株式1株につき2,655円である。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 2655,
         "unit": "円",
         "label": "1株あたりの買付け価格"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "買付け等の価格  当社の普通株式（以下「当社株式」といいます。）１株につき、金2,655円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZH5I）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZH5I）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "買付けをする会社（株式会社ITG-Gホールディングス）は2026年7月17日に設立され、投資会社のインテグラル株式会社が発行済株式の全てを持っている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 17,
         "unit": "日",
         "label": "日付（買付けをする会社の設立日）"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "2026年７月17日付で設立された株式会社であり、本書提出日現在、インテグラル株式会社がその発行済株式の全てを所有しているとのことです",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZH5I）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZH5I）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "書類には、買付けをする会社が、かどや製油の株を非公開化するための取引の一環として、2026年9月14日に買付けをすると決めたと書かれている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 14,
         "unit": "日",
         "label": "日付（買付けの決定日）"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "当社株式を非公開化するための取引（以下「本取引」といいます。）の一環として、2026年９月14日付で本公開買付けを実施することを決定したとのことです",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZH5I）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZH5I）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "買付けが成立する最低の株数（下限）は13,847,100株とされている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 13847100,
         "unit": "株",
         "label": "買付予定数の下限"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "買付予定数の下限（注１）  13,847,100（株）",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZH5I）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZH5I）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "かどや製油の第1位株主は三菱商事で、所有株式数は7,431,000株、所有割合は26.88%と書かれている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 7431000,
         "unit": "株",
         "label": "第1位株主の所有株式数"
        },
        {
         "value": 26.88,
         "unit": "%",
         "label": "第1位株主の所有割合"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "当社の第１位株主である三菱商事株式会社（所有株式数7,431,000株、所有割合：26.88％",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZH5I）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZH5I）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-07",
       "text": "第3位株主の小澤物産は、3,189,558株、所有割合11.54%を持つと書かれている。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 3189558,
         "unit": "株",
         "label": "第3位株主の所有株式数"
        },
        {
         "value": 11.54,
         "unit": "%",
         "label": "第3位株主の所有割合"
        }
       ],
       "source_ref": "SRC-001",
       "excerpt": "当社の第３位株主である小澤物産株式会社（所有株式数3,189,558株、所有割合（注４）：11.54％）",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZH5I）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZH5I）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-08",
       "text": "公開買付けは、決めた値段と期間で、株主から株を買い集める手続きである。「非公開化」は、株を取引所で売り買いできない状態にすることをいう。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-11-15-001-1",
       "text": "上場会社を非公開化する買付けで、別の買い手の提案が出る例が続けば、買付けの期間が延びる例も増える可能性がある。",
