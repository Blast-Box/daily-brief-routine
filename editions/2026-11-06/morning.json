   "section_id": "big",
   "title": "大きな出来事",
   "articles": [
    {
     "article_id": "ART-2026-11-06-001",
     "event_id": "EVT-2026-11-06-001",
     "headline": "光学のニコンの中間期、売上収益は6.9%増：露光装置の精機事業は売上収益29.7%増、カメラの映像事業は10.9%減（法定書類から）",
     "lines": [
      {
       "line_id": "L-001-01",
       "text": "ニコンの中間期（2026年4〜9月）の売上収益は、前年同期より6.9%増えた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 6.9,
         "unit": "%",
         "label": "売上収益の前年同期比の増加率"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "前年同期比217億43百万円（6.9％）の増収",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBMF）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBMF）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-02",
       "text": "親会社の所有者に帰属する中間利益は、前年同期より99.0%増えた。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 99.0,
         "unit": "%",
         "label": "親会社の所有者に帰属する中間利益の前年同期比の増加率"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "親会社の所有者に帰属する中間利益は106億58百万円、前年同期比53億２百万円（99.0％）の増益",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBMF）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBMF）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-03",
       "text": "精機事業は、薄型パネル（FPD）向けの露光装置と、半導体向けのArF露光装置の販売台数が増え、売上収益が前年同期比29.7%増、営業利益が136.9%増だった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 29.7,
         "unit": "%",
         "label": "精機事業の売上収益の前年同期比の増加率"
        },
        {
         "value": 136.9,
         "unit": "%",
         "label": "精機事業の営業利益の前年同期比の増加率"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "当事業の売上収益は906億35百万円、前年同期比29.7％増、営業利益は72億13百万円、前年同期比136.9％増",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBMF）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBMF）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-04",
       "text": "映像事業は、主に中国での需要減でレンズ交換式デジタルカメラと交換レンズの販売が減り、メモリー価格の高騰もあって、売上収益が前年同期比10.9%減、営業利益が46.5%減だった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 10.9,
         "unit": "%",
         "label": "映像事業の売上収益の前年同期比の減少率"
        },
        {
         "value": 46.5,
         "unit": "%",
         "label": "映像事業の営業利益の前年同期比の減少率"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "当事業の売上収益は1,293億２百万円、前年同期比10.9％減、営業利益は82億52百万円、前年同期比46.5％減",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBMF）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBMF）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-05",
       "text": "半導体製造装置・検査機向けの光学部品などを扱うインダストリー事業は、売上収益が前年同期比9.4%増、営業利益が52.7%増だった。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 9.4,
         "unit": "%",
         "label": "インダストリー事業の売上収益の前年同期比の増加率"
        },
        {
         "value": 52.7,
         "unit": "%",
         "label": "インダストリー事業の営業利益の前年同期比の増加率"
        }
       ],
       "source_ref": "SRC-006",
       "excerpt": "事業全体では、売上収益は383億77百万円、前年同期比9.4％増、営業利益75億78百万円、前年同期比52.7％増",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBMF）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBMF）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-001-06",
       "text": "露光装置は、半導体や薄型パネルの回路の模様を、光を使って基板に焼き付ける装置である。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      }
     ],
     "inferences": [
      {
       "inference_id": "INF-2026-11-06-001-1",
       "text": "AI向けの半導体や薄型パネルへの設備投資が続けば、露光装置や光学部品をつくる精密機器業の売上に表れ続ける可能性がある。",
       "falsifier": "次の半期で、露光装置を扱う事業の売上が前年同期を下回れば、この見方は成り立たない。",
       "check_metric": "各社の半期報告書・有価証券報告書の露光装置関連の事業の売上収益",
       "check_by": "2027-06-30"
      }
     ],
     "followup": {
      "is_followup": false,
      "first_seen": null,
      "first_seen_edition_id": null,
      "has_new_source": null
     }
    }
   ]
  },
  {
   "section_id": "change",
   "title": "新しい変化",
   "articles": [
    {
     "article_id": "ART-2026-11-06-003",
     "event_id": "EVT-2026-11-06-003",
     "headline": "荒川化学工業、連結子会社への貸付金に関係会社貸倒引当金繰入額1,335百万円：個別決算の特別損失で、連結業績への影響はないと届け出（法定書類から）",
     "lines": [
      {
       "line_id": "L-003-01",
       "text": "荒川化学工業は、連結子会社の千葉アルコン製造の財政状態を考え、同社への貸付金に対する関係会社貸倒引当金繰入額1,335百万円を、中間期の個別決算の特別損失に計上したと届け出た。",
       "claimed_mark": "source_number_match",
       "numbers": [
        {
         "value": 1335,
         "unit": "百万円",
         "label": "関係会社貸倒引当金繰入額"
        }
       ],
       "source_ref": "SRC-005",
       "excerpt": "関係会社貸倒引当金繰入額　　1,335百万円",
       "attribution": "出典：EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBBM）、PDL1.0（https://www.digital.go.jp/resources/open_data/public_data_license_v1.0）",
       "processing_note": "EDINET閲覧（提出）サイト（https://disclosure2.edinet-fsa.go.jp/WZEK0040.aspx?S100ZBBM）をもとに本サイト作成",
       "mark": "source_number_match",
       "mark_reason": null
      },
      {
       "line_id": "L-003-02",
       "text": "貸倒引当金は、貸したお金が返ってこないおそれに備えて、あらかじめ費用として見積もっておくお金である。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
       "excerpt": null,
       "attribution": null,
       "processing_note": null,
       "mark": "explainer",
       "mark_reason": null
      },
      {
       "line_id": "L-003-03",
       "text": "親会社が子会社に貸したお金は、グループ全体をまとめた連結決算では、グループの中の貸し借りとして差し引かれる。",
       "claimed_mark": "explainer",
       "numbers": [],
       "source_ref": null,
